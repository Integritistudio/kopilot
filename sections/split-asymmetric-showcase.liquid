{{ 'https://fonts.googleapis.com/css2?family=Outfit:wght@400;600&display=swap' | stylesheet_tag }}

{%- style -%}
  @font-face {
    font-family: 'Elza';
    font-weight: 300;
    font-style: normal;
  }

  .showcase-{{ section.id }} {
    width: 100%;
    padding: 70px 222.08px;
    background-color: {{ section.settings.bg_color }};
    box-sizing: border-box;
  }

  .showcase-{{ section.id }} *,
  .showcase-{{ section.id }} *::before,
  .showcase-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .showcase-{{ section.id }} .showcase-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 60px;
    width: 100%;
    max-width: 995.84px;
    margin: 0 auto;
  }

  .showcase-{{ section.id }} .content-column {
    width: 433.84px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 38px;
  }

  .showcase-{{ section.id }} .content-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 45px;
    width: 394px;
  }

  .showcase-{{ section.id }} .showcase-heading {
    font-family: 'Elza', sans-serif;
    font-weight: 300;
    font-size: 60px;
    line-height: 1.1;
    color: #000000;
    margin: 0;
    padding: 0;
    width: 394px;
  }

  .showcase-{{ section.id }} .showcase-paragraph {
    font-family: 'Elza', sans-serif;
    font-weight: 300;
    font-size: 20px;
    line-height: normal;
    color: #000000;
    margin: 0;
    padding: 0;
    width: 377px;
  }

  .showcase-{{ section.id }} .logo-grid-wrapper {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 433.84px;
  }

  .showcase-{{ section.id }} .logo-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 30px;
    width: 100%;
  }

  .showcase-{{ section.id }} .logo-item {
    object-fit: contain;
    object-position: center;
    display: block;
    flex-shrink: 0;
  }

  .showcase-{{ section.id }} .logo-row-1 .logo-item:nth-child(1),
  .showcase-{{ section.id }} .logo-row-1 .logo-item:nth-child(2) {
    width: 82.42px;
    height: 74.483px;
  }

  .showcase-{{ section.id }} .logo-row-1 .logo-item:nth-child(3) {
    width: 67px;
    height: 67px;
  }

  .showcase-{{ section.id }} .logo-row-1 .logo-item:nth-child(4) {
    width: 112px;
    height: 60px;
  }

  .showcase-{{ section.id }} .logo-row-2 .logo-item:nth-child(1) {
    width: 164.919px;
    height: 59.806px;
  }

  .showcase-{{ section.id }} .logo-row-2 .logo-item:nth-child(2) {
    width: 87px;
    height: 74px;
  }

  .showcase-{{ section.id }} .logo-row-2 .logo-item:nth-child(3) {
    width: 68px;
    height: 82px;
  }

  .showcase-{{ section.id }} .interactive-column {
    width: 502px;
    flex-shrink: 0;
  }

  .showcase-{{ section.id }} .interactive-card {
    position: relative;
    width: 502px;
    overflow: hidden;
  }

  .showcase-{{ section.id }} .card-image-wrapper {
    position: relative;
    width: 502px;
    height: 254px;
    overflow: hidden;
    background-color: #e0e0e0;
  }

  .showcase-{{ section.id }} .card-image-wrapper img,
  .showcase-{{ section.id }} .card-image-wrapper .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .showcase-{{ section.id }} .location-badge {
    position: absolute;
    top: 13px;
    left: 13px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 31px;
    padding: 0 24px;
    background: #ffffff;
    color: #000000;
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .showcase-{{ section.id }} .card-text-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 21.516px;
    width: 502px;
    padding: 30.666px 40px;
    background: #f1f1f1;
  }

  .showcase-{{ section.id }} .card-header-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .showcase-{{ section.id }} .card-name {
    font-family: 'Outfit', sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: 0;
    color: #000000;
    margin: 0;
  }

  .showcase-{{ section.id }} .card-subname {
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: 0;
    color: #000000;
    margin: 0;
  }

  .showcase-{{ section.id }} .card-quote,
  .showcase-{{ section.id }} .card-quote p {
    font-family: 'Elza', sans-serif;
    font-weight: 300;
    font-size: 20px;
    line-height: 1.42;
    letter-spacing: 0;
    color: #6e6e6e;
    margin: 0;
    width: 100%;
  }

  .showcase-{{ section.id }} .card-quote a {
    color: inherit;
    font: inherit;
    line-height: inherit;
    text-decoration: underline;
    text-underline-position: from-font;
    text-decoration-skip-ink: none;
  }

  .showcase-{{ section.id }} .tag-container {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 10px;
    width: 100%;
  }

  .showcase-{{ section.id }} .ui-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 31px;
    padding: 0 24px;
    border: 1px solid #000000;
    background: #ffffff;
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: 0;
    color: #000000;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Mid widths — keep desktop structure, scale padding */
  @media screen and (min-width: 768px) and (max-width: 1439px) {
    .showcase-{{ section.id }} {
      padding: 70px clamp(24px, 15.422vw, 222.08px);
    }

    .showcase-{{ section.id }} .showcase-wrapper {
      max-width: 100%;
      gap: clamp(24px, 4.167vw, 60px);
    }

    .showcase-{{ section.id }} .content-column {
      width: clamp(280px, 30.128vw, 433.84px);
    }

    .showcase-{{ section.id }} .content-copy,
    .showcase-{{ section.id }} .showcase-heading {
      width: 100%;
      max-width: 394px;
    }

    .showcase-{{ section.id }} .showcase-heading {
      font-size: clamp(36px, 4.167vw, 60px);
    }

    .showcase-{{ section.id }} .showcase-paragraph {
      width: 100%;
      max-width: 377px;
    }

    .showcase-{{ section.id }} .logo-grid-wrapper {
      width: 100%;
    }

    .showcase-{{ section.id }} .logo-row {
      gap: clamp(12px, 2.083vw, 30px);
      flex-wrap: wrap;
    }

    .showcase-{{ section.id }} .interactive-column,
    .showcase-{{ section.id }} .interactive-card,
    .showcase-{{ section.id }} .card-image-wrapper,
    .showcase-{{ section.id }} .card-text-content {
      width: clamp(320px, 34.861vw, 502px);
    }
  }

  /* Mobile — 360px */
  @media screen and (max-width: 767px) {
    .showcase-{{ section.id }} {
      padding: 50px 22px;
    }

    .showcase-{{ section.id }} .showcase-wrapper {
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 30px;
      max-width: 316px;
      width: 100%;
    }

    .showcase-{{ section.id }} .content-column {
      width: 322px;
      max-width: 100%;
      align-items: center;
      gap: 30px;
    }

    .showcase-{{ section.id }} .content-copy {
      width: 322px;
      max-width: 100%;
      align-items: center;
      gap: 19px;
      text-align: center;
    }

    .showcase-{{ section.id }} .showcase-heading {
      width: 276px;
      max-width: 100%;
      font-size: 30px;
      line-height: 1.1;
      text-align: center;
    }

    .showcase-{{ section.id }} .showcase-paragraph {
      width: 238px;
      max-width: 100%;
      font-size: 15px;
      line-height: normal;
      text-align: center;
    }

    .showcase-{{ section.id }} .logo-grid-wrapper {
      width: 322px;
      max-width: 100%;
      gap: 14.844px;
      align-items: center;
    }

    .showcase-{{ section.id }} .logo-row {
      gap: 22.266px;
      justify-content: center;
      flex-wrap: nowrap;
    }

    .showcase-{{ section.id }} .logo-row-1 .logo-item:nth-child(1),
    .showcase-{{ section.id }} .logo-row-1 .logo-item:nth-child(2) {
      width: 61.172px;
      height: 55.281px;
    }

    .showcase-{{ section.id }} .logo-row-1 .logo-item:nth-child(3) {
      width: 49.727px;
      height: 49.727px;
    }

    .showcase-{{ section.id }} .logo-row-1 .logo-item:nth-child(4) {
      width: 83.126px;
      height: 44.532px;
    }

    .showcase-{{ section.id }} .logo-row-2 {
      justify-content: center;
      width: 281.976px;
      max-width: 100%;
    }

    .showcase-{{ section.id }} .logo-row-2 .logo-item:nth-child(1) {
      width: 122.403px;
      height: 44.388px;
    }

    .showcase-{{ section.id }} .logo-row-2 .logo-item:nth-child(2) {
      width: 64.571px;
      height: 54.923px;
    }

    .showcase-{{ section.id }} .logo-row-2 .logo-item:nth-child(3) {
      width: 50.47px;
      height: 60.86px;
    }

    .showcase-{{ section.id }} .interactive-column,
    .showcase-{{ section.id }} .interactive-card,
    .showcase-{{ section.id }} .card-image-wrapper,
    .showcase-{{ section.id }} .card-text-content {
      width: 316px;
      max-width: 100%;
    }

    .showcase-{{ section.id }} .card-image-wrapper {
      height: 254px;
    }

    .showcase-{{ section.id }} .card-text-content {
      padding: 30.666px 27px;
      gap: 21.516px;
    }

    .showcase-{{ section.id }} .card-quote,
    .showcase-{{ section.id }} .card-quote p {
      max-width: 258px;
    }

    .showcase-{{ section.id }} .tag-container {
      flex-wrap: wrap;
      /* max-width: 242px; */
    }
  }
{%- endstyle -%}

<div class="showcase-{{ section.id }}">
  <div class="showcase-wrapper">
    <div class="content-column">
      <div class="content-copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="showcase-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.paragraph != blank -%}
          <p class="showcase-paragraph">{{ section.settings.paragraph | escape | newline_to_br }}</p>
        {%- endif -%}
      </div>

      <div class="logo-grid-wrapper">
        {%- assign total_logo_count = 0 -%}
        <div class="logo-row logo-row-1">
          {%- for block in section.blocks -%}
            {%- if block.type == 'logo' and block.settings.logo_image != blank -%}
              {%- assign total_logo_count = total_logo_count | plus: 1 -%}
              {%- if total_logo_count <= 4 -%}
                <img
                  class="logo-item"
                  src="{{ block.settings.logo_image | image_url: width: 330 }}"
                  alt="{{ block.settings.logo_image.alt | escape }}"
                  loading="lazy"
                >
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if total_logo_count > 4 -%}
          {%- assign control_counter = 0 -%}
          <div class="logo-row logo-row-2">
            {%- for block in section.blocks -%}
              {%- if block.type == 'logo' and block.settings.logo_image != blank -%}
                {%- assign control_counter = control_counter | plus: 1 -%}
                {%- if control_counter > 4 -%}
                  <img
                    class="logo-item"
                    src="{{ block.settings.logo_image | image_url: width: 330 }}"
                    alt="{{ block.settings.logo_image.alt | escape }}"
                    loading="lazy"
                  >
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="interactive-column">
      <div class="interactive-card">
        <div class="card-image-wrapper">
          {%- if section.settings.card_image != blank -%}
            <img
              src="{{ section.settings.card_image | image_url: width: 1004 }}"
              alt="{{ section.settings.card_image.alt | escape }}"
              loading="lazy"
              width="502"
              height="254"
            >
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {%- if section.settings.badge_text != blank -%}
            <div class="location-badge">{{ section.settings.badge_text | escape }}</div>
          {%- endif -%}
        </div>

        <div class="card-text-content">
          <div class="card-header-group">
            {%- if section.settings.card_heading != blank -%}
              <h3 class="card-name">{{ section.settings.card_heading | escape }}</h3>
            {%- endif -%}

            {%- if section.settings.card_subheading != blank -%}
              <p class="card-subname">{{ section.settings.card_subheading | escape }}</p>
            {%- endif -%}
          </div>

          {%- if section.settings.card_text != blank -%}
            <div class="card-quote">{{ section.settings.card_text }}</div>
          {%- endif -%}

          <div class="tag-container">
            {%- for block in section.blocks -%}
              {%- if block.type == 'pill_tag' and block.settings.tag_title != blank -%}
                <span class="ui-tag">{{ block.settings.tag_title | escape }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Asymmetric Showcase",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Block Text",
      "default": "Trusted by thousands."
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph Description Text",
      "default": "We work with races, events, organizers, and outdoor communities who understand that preparation matters. From pro athletes to weekend warriors, local events to nationally recognized race series."
    },
    {
      "type": "header",
      "content": "Right Side Card Config"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Card Feature Image (Auto-Resized)"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Image Badge Text",
      "default": "US Hard Enduro"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Card Heading/Name",
      "default": "Matt Musgrove"
    },
    {
      "type": "text",
      "id": "card_subheading",
      "label": "Card Subheading Title"
    },
    {
      "type": "richtext",
      "id": "card_text",
      "label": "Card Quote Content text",
      "default": "<p>The first race weekend that we implemented <a href=\"https://kopilot.id/\" target=\"_blank\">KOPILOT.ID</a> as a part of our emergency response, it was used to quickly obtain an injured racer's emergency contact info. <a href=\"https://kopilot.id/\" target=\"_blank\">KOPILOT.ID</a> is a simple solution that just makes sense</p>"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Trusted Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo Asset Source"
        }
      ]
    },
    {
      "type": "pill_tag",
      "name": "Pill Tag",
      "settings": [
        {
          "type": "text",
          "id": "tag_title",
          "label": "Tag Label Text Content",
          "default": "Trans-Rockies"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Asymmetric Showcase",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "pill_tag", "settings": { "tag_title": "Trans-Rockies" } },
        { "type": "pill_tag", "settings": { "tag_title": "AMA" } },
        { "type": "pill_tag", "settings": { "tag_title": "Endurance series" } }
      ]
    }
  ]
}
{% endschema %}
