{{ 'Elza.css' | asset_url | stylesheet_tag }}

{% style %}
  .shopify-section:has(#kopilot-app-download-hero-{{ section.id }}) {
    padding: 0;
  }

  #kopilot-app-download-hero-{{ section.id }} {
    --kah-bg: {{ section.settings.bg_color }};
    --kah-text: {{ section.settings.text_color }};
    --kah-btn-bg: {{ section.settings.button_color }};
    --kah-btn-text: {{ section.settings.button_text_color }};
    position: relative;
    width: 100%;
    min-height: 819px;
    background-color: var(--kah-bg);
    color: var(--kah-text);
    box-sizing: border-box;
    overflow: hidden;
  }

  #kopilot-app-download-hero-{{ section.id }} *,
  #kopilot-app-download-hero-{{ section.id }} *::before,
  #kopilot-app-download-hero-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-bg-img--mobile {
    display: none;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    padding: 37px 111px 0;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1218px;
    margin: 0 auto;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-logo {
    display: block;
    width: 172px;
    height: 19px;
    flex-shrink: 0;
    line-height: 0;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-logo img {
    display: block;
    width: 172px;
    height: 19px;
    object-fit: contain;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-header-cta {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--kah-text);
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-header-cta-label {
    margin: 0;
    padding: 0 16px 0 0;
    font-family: 'Elza', sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: inherit;
    white-space: nowrap;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-header-icon {
    display: block;
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    overflow: hidden;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-header-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 41px;
    width: 100%;
    max-width: 1440px;
    min-height: 819px;
    margin: 0 auto;
    padding: 167px 104px 127px;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    width: 100%;
    color: var(--kah-text);
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-heading {
    margin: 0;
    padding: 0;
    width: 100%;
    font-family: 'Elza', sans-serif;
    font-weight: 300;
    font-size: 120px;
    line-height: 116px;
    letter-spacing: -4.86px;
    color: var(--kah-text);
    word-break: break-word;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-subcopy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    width: 316px;
    max-width: 100%;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-product {
    margin: 0;
    padding: 0;
    width: 160px;
    font-family: 'Elza', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.2;
    color: var(--kah-text);
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-started {
    margin: 0;
    padding: 0;
    width: 100%;
    font-family: 'Elza', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.2;
    color: var(--kah-text);
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 18px 64px;
    min-height: 61px;
    background-color: var(--kah-btn-bg);
    border: 0;
    border-radius: 0;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-btn:hover {
    opacity: 0.9;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-btn-text {
    font-family: 'Elza', sans-serif;
    font-weight: 600;
    font-size: 20px;
    line-height: normal;
    text-transform: uppercase;
    color: var(--kah-btn-text);
    white-space: nowrap;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-stores {
    display: flex;
    align-items: center;
    gap: 30px;
    padding-top: 5px;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-store {
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-store--google {
    width: 101px;
    height: 30px;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-store--apple {
    width: 90px;
    height: 30px;
  }

  #kopilot-app-download-hero-{{ section.id }} .kah-store img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (min-width: 768px) and (max-width: 1439px) {
    #kopilot-app-download-hero-{{ section.id }},
    #kopilot-app-download-hero-{{ section.id }} .kah-inner {
      min-height: clamp(624px, 56.9vw, 819px);
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-header {
      padding: 37px clamp(40px, 7.7vw, 111px) 0;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-inner {
      gap: clamp(29px, 2.85vw, 41px);
      padding: clamp(127px, 11.6vw, 167px) clamp(40px, 7.2vw, 104px) clamp(100px, 8.8vw, 127px);
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-heading {
      font-size: clamp(50px, 8.33vw, 120px);
      line-height: clamp(50px, 8.06vw, 116px);
      letter-spacing: clamp(-2.4px, -0.34vw, -4.86px);
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-product,
    #kopilot-app-download-hero-{{ section.id }} .kah-started {
      font-size: clamp(16px, 1.39vw, 20px);
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-btn {
      min-height: clamp(50px, 4.2vw, 61px);
      padding: clamp(16px, 1.27vw, 18px) clamp(48px, 4.44vw, 64px);
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-btn-text {
      font-size: clamp(15px, 1.4vw, 20px);
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-stores {
      gap: clamp(12px, 2.08vw, 30px);
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-store--google {
      width: clamp(101px, 7vw, 110px);
      height: clamp(30px, 2.1vw, 33px);
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-store--apple {
      width: clamp(90px, 6.2vw, 98px);
      height: clamp(30px, 2.1vw, 33px);
    }
  }

  @media screen and (max-width: 767px) {
    #kopilot-app-download-hero-{{ section.id }},
    #kopilot-app-download-hero-{{ section.id }} .kah-inner {
      min-height: 624px;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-bg-img--desktop {
      display: none;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-bg-img--mobile {
      display: block;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-header {
      justify-content: center;
      padding: 35px 26px 0;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-header-inner {
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      width: 172px;
      height: 58px;
      max-width: 172px;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-inner {
      /* align-items: center; */
      gap: 29px;
      max-width: 360px;
      padding: 127px 0px;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-copy {
      align-items: center;
      text-align: center;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-heading {
      font-size: 50px;
      line-height: 1;
      letter-spacing: -4.86px;
      text-align: center;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-subcopy {
      align-items: center;
      width: 316px;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-product,
    #kopilot-app-download-hero-{{ section.id }} .kah-started {
      text-align: center;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-actions {
      align-items: center;
      gap: 15px;
      padding-top: 7px;
      max-width: 275px;
      width: 100%;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-btn {
      width: 100%;
      min-width: 275px;
      min-height: 50px;
      padding: 16px 62px;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-btn-text {
      font-size: 15px;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-stores {
      gap: 12px;
      padding-top: 0;
      width: 220px;
      justify-content: flex-start;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-store--google {
      width: 110px;
      height: 33px;
    }

    #kopilot-app-download-hero-{{ section.id }} .kah-store--apple {
      width: 98px;
      height: 33px;
    }
  }
{% endstyle %}

{% assign kah_logo = section.settings.logo %}
{% assign kah_icon = section.settings.header_icon %}
{% assign kah_google = section.settings.google_play_badge %}
{% assign kah_apple = section.settings.app_store_badge %}
{% assign kah_img_desktop = section.settings.image_desktop %}
{% assign kah_img_mobile = section.settings.image_mobile %}
{% if kah_img_mobile == blank %}
  {% assign kah_img_mobile = kah_img_desktop %}
{% endif %}

<section class="full-width" id="kopilot-app-download-hero-{{ section.id }}">
  <div class="kah-bg" aria-hidden="true">
    {% if kah_img_desktop != blank %}
      <img
        class="kah-bg-img kah-bg-img--desktop"
        src="{{ kah_img_desktop | image_url: width: 2880 }}"
        alt=""
        loading="eager"
        width="1440"
        height="819"
      >
    {% endif %}

    {% if kah_img_mobile != blank %}
      <img
        class="kah-bg-img kah-bg-img--mobile"
        src="{{ kah_img_mobile | image_url: width: 1080 }}"
        alt=""
        loading="eager"
        width="360"
        height="624"
      >
    {% endif %}
  </div>

  {% if section.settings.show_header %}
    <header class="kah-header">
      <div class="kah-header-inner">
        {% if kah_logo != blank %}
          <a class="kah-logo" href="{{ section.settings.logo_link | default: routes.root_url }}" aria-label="{{ shop.name }}">
            <img
              src="{{ kah_logo | image_url: width: 344 }}"
              alt="{{ shop.name }}"
              loading="eager"
              width="172"
              height="19"
            >
          </a>
        {% else %}
          <span class="kah-logo" aria-hidden="true"></span>
        {% endif %}

        {% if section.settings.header_cta_label != blank %}
          <a class="kah-header-cta" href="{{ section.settings.header_cta_link | default: '#' }}">
            <span class="kah-header-cta-label">{{ section.settings.header_cta_label | escape }}</span>
            {% if kah_icon != blank %}
              <span class="kah-header-icon" aria-hidden="true">
                <img
                  src="{{ kah_icon | image_url: width: 48 }}"
                  alt=""
                  loading="eager"
                  width="24"
                  height="24"
                >
              </span>
            {% endif %}
          </a>
        {% endif %}
      </div>
    </header>
  {% endif %}

  <div class="kah-inner">
    <div class="kah-copy">
      {% if section.settings.heading != blank %}
        <h1 class="kah-heading">{{ section.settings.heading | newline_to_br }}</h1>
      {% endif %}

      <div class="kah-subcopy">
        {% if section.settings.product_label != blank %}
          <div class="kah-product">{{ section.settings.product_label | newline_to_br }}</div>
        {% endif %}

        {% if section.settings.started_text != blank %}
          <p class="kah-started">{{ section.settings.started_text | escape }}</p>
        {% endif %}
      </div>
    </div>

    <div class="kah-actions">
      {% if section.settings.button_label != blank %}
        <a class="kah-btn" href="{{ section.settings.button_link | default: '#' }}">
          <span class="kah-btn-text">{{ section.settings.button_label | escape }}</span>
        </a>
      {% endif %}

      {% if kah_google != blank or kah_apple != blank %}
        <div class="kah-stores">
          {% if kah_google != blank %}
            <a
              class="kah-store kah-store--google"
              href="{{ section.settings.google_play_link | default: '#' }}"
              {% if section.settings.google_play_link != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
              aria-label="Get it on Google Play"
            >
              <img
                src="{{ kah_google | image_url: width: 220 }}"
                alt="Get it on Google Play"
                loading="lazy"
                width="101"
                height="30"
              >
            </a>
          {% endif %}

          {% if kah_apple != blank %}
            <a
              class="kah-store kah-store--apple"
              href="{{ section.settings.app_store_link | default: '#' }}"
              {% if section.settings.app_store_link != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
              aria-label="Download on the App Store"
            >
              <img
                src="{{ kah_apple | image_url: width: 196 }}"
                alt="Download on the App Store"
                loading="lazy"
                width="90"
                height="30"
              >
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "App Download Hero",
  "tag": "section",
  "class": "section-kopilot-app-download-hero",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show section header",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "url",
      "id": "logo_link",
      "label": "Logo link"
    },
    {
      "type": "text",
      "id": "header_cta_label",
      "label": "Header CTA label",
      "default": "get kopilot.id"
    },
    {
      "type": "url",
      "id": "header_cta_link",
      "label": "Header CTA link"
    },
    {
      "type": "image_picker",
      "id": "header_icon",
      "label": "Header CTA icon"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Help is only\na tap away"
    },
    {
      "type": "textarea",
      "id": "product_label",
      "label": "Product label",
      "default": "Digital\nEmergency\nID Tag"
    },
    {
      "type": "text",
      "id": "started_text",
      "label": "Supporting text",
      "default": "Get started by downloading our app!"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "download the app"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#EF0008"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "App stores"
    },
    {
      "type": "image_picker",
      "id": "google_play_badge",
      "label": "Google Play badge"
    },
    {
      "type": "url",
      "id": "google_play_link",
      "label": "Google Play link"
    },
    {
      "type": "image_picker",
      "id": "app_store_badge",
      "label": "App Store badge"
    },
    {
      "type": "url",
      "id": "app_store_link",
      "label": "App Store link"
    }
  ],
  "presets": [
    {
      "name": "App Download Hero"
    }
  ]
}
{% endschema %}
