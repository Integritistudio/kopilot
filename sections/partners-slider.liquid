<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400&display=swap" rel="stylesheet">

{%- style -%}
  .marquee-slider-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    padding-top: 70px;
    padding-bottom: 70px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  .marquee-slider-{{ section.id }} .text-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
    margin: 0 auto;
    max-width: 620px;
    width: 100%;
    box-sizing: border-box;
  }

  .marquee-slider-{{ section.id }} .marquee-heading {
    font-family: 'Elza', sans-serif;
    font-weight: 300;
    color: #000000;
    margin: 0;
    padding: 0;
    font-size: 60px;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .marquee-slider-{{ section.id }} .marquee-paragraph {
    font-family: 'Elza', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: 0;
    color: #000000;
    margin: 0;
    padding: 0;
    max-width: 620px;
  }

  .marquee-slider-{{ section.id }} .slider-container {
    width: 100%;
    overflow: hidden;
    position: relative;
    display: flex;
  }

  .marquee-slider-{{ section.id }} .marquee-track {
    display: flex;
    align-items: center;
    user-select: none;
    gap: 17.924px;
    animation: smoothMarquee-{{ section.id }} {{ section.settings.speed }}s linear infinite;
    will-change: transform;
  }

  {% if section.settings.pause_on_hover %}
  .marquee-slider-{{ section.id }} .slider-container:hover .marquee-track {
    animation-play-state: paused;
  }
  {% endif %}

  /* Desktop — 1440px */
  .marquee-slider-{{ section.id }} .slider-card {
    position: relative;
    flex-shrink: 0;
    width: 346.556px;
    height: 346.556px;
    overflow: hidden;
  }

  .marquee-slider-{{ section.id }} .slider-card img,
  .marquee-slider-{{ section.id }} .slider-card .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .marquee-slider-{{ section.id }} .slider-card__name {
    position: absolute;
    right: 19.56px;
    bottom: 18.24px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 31px;
    padding: 0 24px;
    background-color: #ffffff;
    border: 1px solid #000000;
    box-sizing: border-box;
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.2;
    letter-spacing: 0;
    color: #000000;
    text-transform: uppercase;
    white-space: nowrap;
    margin: 0;
  }

  @keyframes smoothMarquee-{{ section.id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 8.962px));
    }
  }

  /* Mobile — 360px */
  @media screen and (max-width: 767px) {
    .marquee-slider-{{ section.id }} {
      padding-top: 70px;
      padding-bottom: 70px;
      gap: 40px;
    }

    .marquee-slider-{{ section.id }} .text-container {
      max-width: 292px;
      padding-left: 0;
      padding-right: 0;
    }

    .marquee-slider-{{ section.id }} .marquee-heading {
      font-size: 30px;
    }

    .marquee-slider-{{ section.id }} .marquee-paragraph {
      font-size: 15px;
      line-height: 1.2;
      max-width: 292px;
    }

    .marquee-slider-{{ section.id }} .marquee-track {
      gap: 9.788px;
      animation-name: smoothMarqueeMobile-{{ section.id }};
    }

    .marquee-slider-{{ section.id }} .slider-card {
      width: 189.24px;
      height: 189.24px;
    }

    .marquee-slider-{{ section.id }} .slider-card__name {
      right: 10.94px;
      bottom: 9.96px;
      height: 16.92px;
      padding: 0 13.105px;
      border-width: 0.546px;
      font-size: 8.737px;
    }
  }

  @keyframes smoothMarqueeMobile-{{ section.id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-50% - 4.894px));
    }
  }
{%- endstyle -%}

<div class="marquee-slider-{{ section.id }} section-{{ section.id }}-padding">
  <div class="text-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="marquee-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.paragraph != blank -%}
      <p class="marquee-paragraph">{{ section.settings.paragraph | escape }}</p>
    {%- endif -%}
  </div>

  <div class="slider-container">
    <div class="marquee-track">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'image_card' -%}
            <div class="slider-card" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {%- liquid
                  assign card_alt = block.settings.name | default: block.settings.image.alt
                -%}
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', alt: card_alt
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
              {%- if block.settings.name != blank -%}
                <p class="slider-card__name">{{ block.settings.name | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Partners Slider Loop",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We live this industry."
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph Text",
      "default": "Our leadership team rides, runs, backpacks, climbs, and has spent countless days in the backcountry - we built something that we knew was missing."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Animation Duration (Speed)",
      "default": 26
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause marquee on hover",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "Slider Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name label",
          "default": "NAME"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Partners Slider Loop",
      "blocks": [
        { "type": "image_card", "settings": { "name": "JAKE" } },
        { "type": "image_card", "settings": { "name": "BLAKE" } },
        { "type": "image_card", "settings": { "name": "BROOK" } },
        { "type": "image_card", "settings": { "name": "MARK" } }
      ]
    }
  ]
}
{% endschema %}
