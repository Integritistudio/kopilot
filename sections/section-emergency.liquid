{{ 'Elza.css' | asset_url | stylesheet_tag }}
{{ 'section-emergency.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_image = section.settings.bg_image
-%}

<div class="emergency-section-wrapper">

  {%- comment -%} Full-bleed mountain — desktop image only (no separate mobile crop) {%- endcomment -%}
  <div class="emergency-section__bg" aria-hidden="true">
    <picture>
      {%- if bg_image != blank -%}
        {{
          bg_image
          | image_url: width: 2880
          | image_tag:
            class: 'emergency-section__bg-img',
            loading: 'eager',
            widths: '750, 1100, 1440, 1920, 2400, 2880',
            sizes: '100vw',
            alt: ''
        }}
      {%- endif -%}
    </picture>
  </div>

  <section class="emergency-section">
    <div class="emergency-error-banner" data-emergency-error-banner hidden>
      <p data-emergency-error-text>Tag not found or Medical Id disabled</p>
    </div>

    <div class="summary emergency-block">
      <div class="summary-header">
        <div class="summary-header__icon">
          {% render 'icon-star-2' %}
          <h3>Emergency Snapshot<sup>&trade;</sup></h3>
        </div>
        <a href="https://translate.google.com/?tl=en&text=" target="_blank" rel="noopener" class="summary-header__icon-translate">
          <img src="https://www.kopilot.id/cdn/shop/t/3/assets/icon.translate.png?v=168121860044578228121772717611" alt="Translate" width="32" height="26">
          <span class="summary-header__translate-text">translate</span>
        </a>
      </div>
      <div class="summary-content">
        <div class="ai-text-part">-</div>
        <div class="emergency-contact-part"></div>
      </div>
    </div>

    <div class="emergency-info">
      <div class="personal-information emergency-block">
        <div class="personal-header">
          <h3>Personal information</h3>
          {% render 'icon-heart' %}
        </div>
        <div class="personal-information__content">
          <div>
            <h3 class="name">--</h3>
            <div class="personal-information__grid">
              <div>
                <p class="emergency-section__note">Gender</p>
                <b class="emergency-section__desc gender">--</b>
              </div>
              <div>
                <p class="emergency-section__note">Weight</p>
                <b class="emergency-section__desc weight">--</b>
              </div>
              <div>
                <p class="emergency-section__note">Age</p>
                <b class="emergency-section__desc age">--</b>
              </div>
              <div>
                <p class="emergency-section__note">Height</p>
                <b class="emergency-section__desc height">--</b>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="medical-information emergency-block">
        <div class="medical-header">
          <h3>Medical information</h3>
          {% render 'icon-pill' %}
        </div>
        <div class="medical-content">
          <p class="emergency-section__note">Special Notes</p>
          <h3 class="emergency-section__desc help">&lt;None Specified&gt;</h3>
          <p class="emergency-section__note medical-conditions__heading">Medical Conditions</p>
          <h3 class="emergency-section__desc medical-conditions">&lt;None Specified&gt;</h3>
          <p class="emergency-section__note">Allergies</p>
          <h3 class="emergency-section__desc allergies">&lt;None Specified&gt;</h3>
          <p class="emergency-section__note">Medications</p>
          <h3 class="emergency-section__desc medications">&lt;None Specified&gt;</h3>
        </div>
      </div>

      <div class="emergency-notes emergency-block">
        <div class="emergency-header">
          <h3>Emergency Contact</h3>
          {% render 'icon-emergency' %}
        </div>
        <div class="medical-content">
          <p class="emergency-section__note">Name</p>
          <b class="emergency-section__desc emergency-name">--</b>
          <p class="emergency-section__note">Phone</p>
          <a href="" class="emergency-section__desc phone">--</a>
        </div>
      </div>

      <div class="emergency-button emergency-block">
        <span class="emergency-button__block">
          <span class="emergency-button__text">New to KOPILOT.ID?</span>
          {% if section.settings.button_txt != blank %}
            <a
              href="{% if section.settings.button_url != blank %}{{ section.settings.button_url }}{% else %}{{ routes.root_url }}{% endif %}"
              class="emergency-button__btn"
            >
              {{ section.settings.button_txt }}
              <b>&gt;</b>
            </a>
          {% endif %}
        </span>
      </div>
    </div>
  </section>

  <div
    class="emergency-error-popup"
    data-emergency-error-popup
    role="alertdialog"
    aria-modal="true"
    aria-labelledby="emergency-error-title"
    aria-hidden="true"
    hidden
  >
    <div class="emergency-error-popup__overlay" data-emergency-error-close></div>
    <div class="emergency-error-popup__dialog">
      <button type="button" class="emergency-error-popup__close" data-emergency-error-close aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
      <p class="emergency-error-popup__kicker">KOPILOT.ID</p>
      <h2 class="emergency-error-popup__title" id="emergency-error-title">Unable to load emergency profile</h2>
      <p class="emergency-error-popup__text" data-emergency-error-text>Tag not found or Medical Id disabled</p>
      <button type="button" class="emergency-error-popup__btn" data-emergency-error-close>OK</button>
    </div>
  </div>

</div>

{{ 'section-emergency.js' | asset_url | script_tag }}

<script>
  (function () {
    if (window.Shopify && (Shopify.designMode || Shopify.visualPreviewMode)) return;

    var REDIRECT_AFTER_MS = 600000;
    var START_KEY = 'emergencyViewStartedAt';
    var TAG_KEY = 'emergencyViewTagId';
    var targetUrl = {{ shop.url | json }};
    var timerId = null;

    function getTagId() {
      try {
        var fromUrl = new URLSearchParams(window.location.search).get('t');
        if (fromUrl) return String(fromUrl);
        var stored = localStorage.getItem('tagId');
        if (!stored) return '';
        var parsed = JSON.parse(stored);
        return parsed == null ? '' : String(parsed);
      } catch (e) {
        return '';
      }
    }

    function startViewSession(tagId) {
      sessionStorage.setItem(START_KEY, String(Date.now()));
      if (tagId) sessionStorage.setItem(TAG_KEY, tagId);
      try {
        localStorage.removeItem('redirectStartTime');
      } catch (e) {}
    }

    var tagId = getTagId();
    if (tagId) {
      try {
        localStorage.setItem('tagId', JSON.stringify(tagId));
      } catch (e) {}
    }

    var startedAt = parseInt(sessionStorage.getItem(START_KEY), 10);
    var previousTag = sessionStorage.getItem(TAG_KEY) || '';
    var expired = !startedAt || isNaN(startedAt) || Date.now() - startedAt >= REDIRECT_AFTER_MS;
    var isNewTag = Boolean(tagId && tagId !== previousTag);

    // New scan, first visit, or an already-expired window must start fresh.
    // Never send someone home the moment they land on this page.
    if (expired || isNewTag) {
      startViewSession(tagId);
    }

    function checkRedirect() {
      if (window.Shopify && (Shopify.designMode || Shopify.visualPreviewMode)) return;

      var started = parseInt(sessionStorage.getItem(START_KEY), 10);
      if (!started || isNaN(started)) {
        startViewSession(getTagId());
        started = Date.now();
      }

      if (Date.now() - started >= REDIRECT_AFTER_MS) {
        try {
          sessionStorage.removeItem(START_KEY);
          localStorage.removeItem('redirectStartTime');
        } catch (e) {}
        window.location.href = targetUrl;
        return;
      }

      timerId = setTimeout(checkRedirect, 1000);
    }

    checkRedirect();

    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'visible') {
        if (timerId) clearTimeout(timerId);
        checkRedirect();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Section Emergency",
  "tag": "div",
  "class": "section-emergency",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image"
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "button_txt",
      "label": "Button text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "presets": [
    {
      "name": "Emergency Section"
    }
  ]
}
{% endschema %}
