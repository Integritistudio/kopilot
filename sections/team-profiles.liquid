{%- liquid
  assign member_count = 0
  for block in section.blocks
    if block.type == 'team_member'
      assign member_count = member_count | plus: 1
    endif
  endfor
  assign is_scrollable = false
  if member_count >= 3
    assign is_scrollable = true
  endif
-%}

<div id="our-team">
  <div
    id="TeamProfiles-{{ section.id }}"
    class="team-profiles-section{% if is_scrollable %} team-profiles-section--scrollable{% endif %}"
    data-tp-root
  >
    <div class="team-profiles__container">
      {%- if section.settings.heading != blank or section.settings.paragraph != blank -%}
        <div class="team-profiles__header-group">
          {%- if section.settings.heading != blank -%}
            <h2 class="team-profiles__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.paragraph != blank -%}
            <div class="team-profiles__paragraph">
              {{ section.settings.paragraph }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="team-profiles__carousel">
        <div
          class="team-profiles__grid{% if is_scrollable %} is-scrollable{% endif %}"
          {% if is_scrollable %}data-tp-track{% endif %}
        >
          {%- for block in section.blocks -%}
            {%- if block.type == 'team_member' -%}
              <div class="team-profiles__card" {{ block.shopify_attributes }}>
                <div class="team-profiles__image-wrapper">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 824
                      | image_tag:
                        loading: 'lazy',
                        class: 'team-profiles__img',
                        sizes: '(max-width: 767px) 305px, 412px',
                        alt: block.settings.name | default: 'Team member image'
                    }}
                  {%- else -%}
                    <div class="team-profiles__img-placeholder"></div>
                  {%- endif -%}
                </div>

                <div class="team-profiles__text-wrapper">
                  {%- if block.settings.name != blank -%}
                    <h3 class="team-profiles__name">{{ block.settings.name | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.role != blank -%}
                    <p class="team-profiles__role">{{ block.settings.role | escape }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if is_scrollable -%}
          <div class="team-profiles__progress" aria-hidden="true">
            <div class="team-profiles__progress-track"></div>
            <div class="team-profiles__progress-fill" data-tp-progress-fill></div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% style %}
  #TeamProfiles-{{ section.id }}.team-profiles-section {
    background-color: #ffffff;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
  }

  #TeamProfiles-{{ section.id }} *,
  #TeamProfiles-{{ section.id }} *::before,
  #TeamProfiles-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #TeamProfiles-{{ section.id }} .team-profiles__paragraph a {
    color: inherit;
    font: inherit;
    line-height: inherit;
    text-decoration: underline;
    text-underline-position: from-font;
    text-decoration-skip-ink: none;
  }

  /* -------------------------------------------------------------------------
     DESKTOP (1440px)
     ------------------------------------------------------------------------- */
  @media screen and (min-width: 768px) {
    #TeamProfiles-{{ section.id }} .team-profiles__container {
      width: 100%;
      max-width: 1440px;
      padding: 60px 81px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 67px;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__header-group {
      width: 100%;
      max-width: 776px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      text-align: center;
    }

    #TeamProfiles-{{ section.id }} h2.team-profiles__heading {
      font-family: 'Elza', sans-serif;
      font-size: 60px;
      font-weight: 300;
      line-height: 1.1;
      letter-spacing: 0;
      color: #000000;
      margin: 0;
      padding: 0;
      text-transform: none;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__paragraph,
    #TeamProfiles-{{ section.id }} .team-profiles__paragraph p {
      font-family: 'Elza', sans-serif;
      font-size: 20px;
      font-weight: 400;
      line-height: 1.2;
      letter-spacing: 0;
      color: #000000;
      width: 100%;
      max-width: 776px;
      margin: 0;
      padding: 0;
      text-align: center;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__carousel {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 40px;
      width: 100%;
      max-width: 1278px;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__grid {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      justify-content: center;
      align-items: center;
      gap: 21px;
      width: 100%;
    }

    /* 3+ members: horizontal scroll, ~2 cards visible */
    #TeamProfiles-{{ section.id }} .team-profiles__grid.is-scrollable {
      justify-content: flex-start;
      max-width: 845px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      cursor: grab;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__grid.is-scrollable::-webkit-scrollbar {
      display: none;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__grid.is-scrollable.is-dragging {
      cursor: grabbing;
      scroll-behavior: auto;
      user-select: none;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__card {
      flex: 0 0 412px;
      width: 412px;
      min-height: 414px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__image-wrapper {
      width: 412px;
      height: 334px;
      overflow: hidden;
      flex-shrink: 0;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__img,
    #TeamProfiles-{{ section.id }} .team-profiles__img-placeholder {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__img-placeholder {
      background-color: #c4c4c4;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__text-wrapper {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      text-align: center;
    }

    #TeamProfiles-{{ section.id }} h3.team-profiles__name {
      font-family: 'Elza', sans-serif;
      font-size: 30px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0;
      text-transform: uppercase;
      color: #000000;
      margin: 0;
    }

    #TeamProfiles-{{ section.id }} p.team-profiles__role {
      font-family: 'Elza', sans-serif;
      font-size: 16px;
      font-weight: 400;
      line-height: 1;
      letter-spacing: 0;
      color: #595959;
      margin: 0;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__progress {
      position: relative;
      width: 100%;
      max-width: 886px;
      height: 4.57px;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__progress-track {
      position: absolute;
      left: 26.55px;
      top: 0;
      width: calc(100% - 26.55px);
      max-width: 859.448px;
      height: 4.57px;
      background-color: #d9d9d9;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__progress-fill {
      position: absolute;
      left: 0;
      top: 0;
      width: 285.085px;
      max-width: 100%;
      height: 4.57px;
      background-color: #7a7a7a;
      transition: width 0.05s linear;
    }
  }

  /* -------------------------------------------------------------------------
     MOBILE (360px)
     ------------------------------------------------------------------------- */
  @media screen and (max-width: 767px) {
    #TeamProfiles-{{ section.id }}.team-profiles-section {
      padding: 70px 0;
      width: 100%;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__container {
      width: 100%;
      max-width: 360px;
      margin: 0 auto;
      padding: 0 27.5px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 30px;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__header-group {
      width: 100%;
      max-width: 288px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      text-align: center;
    }

    #TeamProfiles-{{ section.id }} h2.team-profiles__heading {
      font-family: 'Elza', sans-serif;
      font-size: 30px;
      font-weight: 300;
      line-height: 1.1;
      letter-spacing: 0;
      color: #000000;
      margin: 0;
      padding: 0;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__paragraph,
    #TeamProfiles-{{ section.id }} .team-profiles__paragraph p {
      font-family: 'Elza', sans-serif;
      font-size: 15px;
      font-weight: 400;
      line-height: 1.2;
      letter-spacing: 0;
      color: #000000;
      width: 100%;
      max-width: 288px;
      margin: 0;
      padding: 0;
      text-align: center;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__carousel {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
      width: 100%;
      max-width: 305px;
    }

    /* ≤2 members: vertical stack, no scroll */
    #TeamProfiles-{{ section.id }} .team-profiles__grid {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      width: 305px;
    }

    /* 3+ members: horizontal scroll */
    #TeamProfiles-{{ section.id }} .team-profiles__grid.is-scrollable {
      flex-direction: row;
      flex-wrap: nowrap;
      justify-content: flex-start;
      align-items: flex-start;
      width: 305px;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      cursor: grab;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__grid.is-scrollable::-webkit-scrollbar {
      display: none;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__grid.is-scrollable.is-dragging {
      cursor: grabbing;
      scroll-behavior: auto;
      user-select: none;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__card {
      flex: 0 0 305px;
      width: 305px;
      height: 313.9px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__image-wrapper {
      width: 305px;
      height: 246.9px;
      overflow: hidden;
      flex-shrink: 0;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__img,
    #TeamProfiles-{{ section.id }} .team-profiles__img-placeholder {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__img-placeholder {
      background-color: #c4c4c4;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__text-wrapper {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      text-align: center;
    }

    #TeamProfiles-{{ section.id }} h3.team-profiles__name {
      font-family: 'Elza', sans-serif;
      font-size: 20px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0;
      text-transform: uppercase;
      color: #000000;
      margin: 0;
    }

    #TeamProfiles-{{ section.id }} p.team-profiles__role {
      font-family: 'Elza', sans-serif;
      font-size: 15px;
      font-weight: 400;
      line-height: 1;
      letter-spacing: 0;
      color: #595959;
      margin: 0;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__progress {
      position: relative;
      width: 100%;
      max-width: 305px;
      height: 4px;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__progress-track {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 4px;
      background-color: #d9d9d9;
    }

    #TeamProfiles-{{ section.id }} .team-profiles__progress-fill {
      position: absolute;
      left: 0;
      top: 0;
      width: 33%;
      height: 4px;
      background-color: #7a7a7a;
      transition: width 0.05s linear;
    }
  }
{% endstyle %}

{%- if is_scrollable -%}
<script>
(function () {
  var root = document.getElementById('TeamProfiles-{{ section.id }}');
  if (!root) return;

  var track = root.querySelector('[data-tp-track]');
  var fill = root.querySelector('[data-tp-progress-fill]');
  if (!track || !fill) return;

  function updateProgress() {
    var maxScroll = track.scrollWidth - track.clientWidth;
    var ratio = maxScroll > 0 ? track.scrollLeft / maxScroll : 0;
    var progressEl = fill.parentElement;
    var progressWidth = progressEl ? progressEl.clientWidth : track.clientWidth;
    var isMobile = window.matchMedia('(max-width: 767px)').matches;
    var minFill;
    var maxFill;
    var width;

    if (isMobile) {
      minFill = progressWidth * 0.33;
      maxFill = progressWidth;
    } else {
      minFill = Math.min(285.085, progressWidth);
      maxFill = progressWidth;
    }

    width = minFill + (maxFill - minFill) * ratio;
    width = Math.min(width, progressWidth);
    fill.style.width = width + 'px';
  }

  track.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);

  var isDown = false;
  var startX = 0;
  var scrollLeft = 0;
  var moved = false;

  track.addEventListener('mousedown', function (e) {
    isDown = true;
    moved = false;
    track.classList.add('is-dragging');
    startX = e.pageX - track.offsetLeft;
    scrollLeft = track.scrollLeft;
  });

  window.addEventListener('mouseup', function () {
    isDown = false;
    track.classList.remove('is-dragging');
  });

  track.addEventListener('mouseleave', function () {
    isDown = false;
    track.classList.remove('is-dragging');
  });

  track.addEventListener('mousemove', function (e) {
    if (!isDown) return;
    e.preventDefault();
    var x = e.pageX - track.offsetLeft;
    var walk = (x - startX) * 1.2;
    if (Math.abs(walk) > 3) moved = true;
    track.scrollLeft = scrollLeft - walk;
  });

  track.addEventListener('click', function (e) {
    if (moved) {
      e.preventDefault();
      e.stopPropagation();
    }
  }, true);

  updateProgress();
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Team Profiles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The people behind it."
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Description Paragraph",
      "default": "<p>Our leadership team has an extensive background delivering technology solutions to the outdoor recreation and powersports industries. Lives spent in these spaces taught us a lot - <a href=\"https://kopilot.id/\" target=\"_blank\">KOPILOT.ID</a> was born from what we learned along the way.</p>"
    }
  ],
  "blocks": [
    {
      "type": "team_member",
      "name": "Team Member",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Member Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "JUSTIN"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Co-founder"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team Profiles",
      "blocks": [
        {
          "type": "team_member",
          "settings": {
            "name": "JUSTIN",
            "role": "Co-founder"
          }
        },
        {
          "type": "team_member",
          "settings": {
            "name": "MARK",
            "role": "Co-founder"
          }
        },
        {
          "type": "team_member",
          "settings": {
            "name": "BLAKE",
            "role": "Community & Content"
          }
        }
      ]
    }
  ]
}
{% endschema %}
