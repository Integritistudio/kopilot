{{ 'Elza.css' | asset_url | stylesheet_tag }}

{% style %}
  .shopify-section:has(.kopilot-explore-confidence-{{ section.id }}) {
    padding: 0;
  }

  .kopilot-explore-confidence-{{ section.id }} {
    --kec-bg: {{ section.settings.bg_color }};
    --kec-text: {{ section.settings.text_color }};
    --kec-media-bg: {{ section.settings.media_bg_color }};
    width: 100%;
    background-color: var(--kec-bg);
    color: var(--kec-text);
    box-sizing: border-box;
    overflow: hidden;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 98px;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-media {
    position: relative;
    flex: 0 0 720px;
    width: 720px;
    height: 655px;
    overflow: hidden;
    background-color: var(--kec-media-bg);
    box-sizing: border-box;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-media > img,
  .kopilot-explore-confidence-{{ section.id }} .kec-media > video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-media > .kec-media-el--mobile {
    display: none;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    flex: 0 0 512px;
    width: 512px;
    max-width: 512px;
    color: var(--kec-text);
    box-sizing: border-box;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-heading {
    margin: 0;
    padding: 0;
    width: 100%;
    font-family: 'Elza', sans-serif;
    font-style: normal;
    font-weight: 300;
    font-size: 60px;
    line-height: 1.06;
    letter-spacing: -1px;
    color: var(--kec-text);
    text-align: left;
    text-transform: none;
    word-break: break-word;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-heading > span {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    color: inherit;
    font-weight: 300;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-heading > .kec-heading-em {
    font-weight: 500;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
    width: 100%;
    box-sizing: border-box;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-body > p {
    margin: 0;
    padding: 0;
    font-family: 'Elza', sans-serif;
    font-style: normal;
    font-size: 20px;
    line-height: 1.2;
    letter-spacing: 0;
    color: var(--kec-text);
    text-align: left;
    text-transform: none;
    word-break: break-word;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-body > p.kec-text {
    max-width: 370px;
    font-weight: 400;
  }

  .kopilot-explore-confidence-{{ section.id }} .kec-body > p.kec-tagline {
    font-weight: 500;
  }

  @media screen and (min-width: 768px) and (max-width: 1439px) {
    .kopilot-explore-confidence-{{ section.id }} .kec-inner {
      gap: clamp(40px, 6.806vw, 98px);
      padding: 0 clamp(24px, 3.472vw, 50px) 0 0;
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-media {
      flex: 0 0 clamp(360px, 50vw, 720px);
      width: clamp(360px, 50vw, 720px);
      height: clamp(360px, 45.486vw, 655px);
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-copy {
      flex: 1 1 auto;
      width: auto;
      max-width: 512px;
      gap: clamp(24px, 2.778vw, 40px);
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-heading {
      font-size: clamp(36px, 4.167vw, 60px);
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-body > p {
      font-size: clamp(16px, 1.389vw, 20px);
    }
  }

  /* Mobile — Figma 360 */
  @media screen and (max-width: 767px) {
    .kopilot-explore-confidence-{{ section.id }} {
      overflow: visible;
      padding-bottom: 76px;
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-inner {
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 32px;
      max-width: 360px;
      padding: 0;
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-media {
      flex: none;
      width: 100%;
      max-width: 360px;
      height: 327.5px;
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-media > .kec-media-el--desktop {
      display: none;
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-media > .kec-media-el--mobile,
    .kopilot-explore-confidence-{{ section.id }} .kec-media > .kec-media-el--desktop.kec-media-el--only {
      display: block;
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-copy {
      align-items: center;
      flex: none;
      width: 100%;
      max-width: 360px;
      gap: 25px;
      text-align: center;
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-heading {
      font-size: 30px;
      text-align: center;
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-body {
      align-items: center;
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-body > p {
      font-size: 16px;
      text-align: center;
    }

    .kopilot-explore-confidence-{{ section.id }} .kec-body > p.kec-text {
      max-width: 287px;
    }
  }
{% endstyle %}

{%- liquid
  assign kec_video = section.settings.media_video
  assign kec_img = section.settings.image_desktop
  assign kec_img_mobile = section.settings.image_mobile
  if kec_img_mobile == blank
    assign kec_img_mobile = kec_img
  endif
-%}

<section
  class="kopilot-explore-confidence kopilot-explore-confidence-{{ section.id }} full-width{% if section.settings.extra_class != blank %} {{ section.settings.extra_class | strip | escape }}{% endif %}"
>
  <div class="kec-inner">
    <div class="kec-media">
      {% if kec_video != blank %}
        {{
          kec_video
          | video_tag:
            class: 'kec-media-el',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            image_size: '1440x',
            preload: 'metadata'
        }}
      {% elsif kec_img != blank %}
        {% if section.settings.image_mobile != blank %}
          <img
            class="kec-media-el kec-media-el--desktop"
            src="{{ kec_img | image_url: width: 1440 }}"
            alt=""
            loading="lazy"
            width="720"
            height="655"
          >
          <img
            class="kec-media-el kec-media-el--mobile"
            src="{{ kec_img_mobile | image_url: width: 720 }}"
            alt=""
            loading="lazy"
            width="360"
            height="328"
          >
        {% else %}
          <img
            class="kec-media-el kec-media-el--desktop kec-media-el--only"
            src="{{ kec_img | image_url: width: 1440 }}"
            alt="{{ section.settings.heading_line_1 | escape }} {{ section.settings.heading_line_2 | escape }}"
            loading="lazy"
            width="720"
            height="655"
          >
        {% endif %}
      {% endif %}
    </div>

    <div class="kec-copy">
      {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
        <h2 class="kec-heading">
          {% if section.settings.heading_line_1 != blank %}
            <span>{{ section.settings.heading_line_1 | escape }}</span>
          {% endif %}
          {% if section.settings.heading_line_1 != blank and section.settings.heading_line_2 != blank %}
            <br>
          {% endif %}
          {% if section.settings.heading_line_2 != blank %}
            <span class="kec-heading-em">{{ section.settings.heading_line_2 | escape }}</span>
          {% endif %}
        </h2>
      {% endif %}

      <div class="kec-body">
        {% if section.settings.text != blank %}
          <p class="kec-text">{{ section.settings.text | strip_html | newline_to_br }}</p>
        {% endif %}

        {% if section.settings.tagline != blank %}
          <p class="kec-tagline">{{ section.settings.tagline | strip_html | newline_to_br }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Explore with Confidence",
  "tag": "section",
  "class": "section-kopilot-explore-confidence",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "media_video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image / GIF (desktop)",
      "info": "Used when no video is set."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image / GIF (mobile)",
      "info": "Optional. Falls back to desktop image."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "media_bg_color",
      "label": "Media placeholder color",
      "default": "#F5F5F5"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Explore with"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "Confidence"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "info": "Plain text only — do not type <p> tags. Each new line = a line break.",
      "default": "Quick access to your unique health\ninformation can be critical in an\nemergency. KOPILOT.ID uses NFC\ntechnology combined with simple-to-use\nAI to provide you with peace of mind and\nthose helping you with details that may\nsave your life."
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "info": "Plain text only. Put each line on its own row.",
      "default": "Explore with Confidence.\nWe've got your back!"
    },
    {
      "type": "text",
      "id": "extra_class",
      "label": "Extra class",
      "info": "Optional CSS class for this section instance."
    }
  ],
  "presets": [
    {
      "name": "Explore with Confidence"
    }
  ]
}
{% endschema %}
