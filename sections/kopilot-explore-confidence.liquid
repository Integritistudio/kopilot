{{ 'Elza.css' | asset_url | stylesheet_tag }}

{% style %}
  .shopify-section:has(#kopilot-explore-confidence-{{ section.id }}) {
    padding: 0;
  }

  #kopilot-explore-confidence-{{ section.id }} {
    --kec-bg: {{ section.settings.bg_color }};
    --kec-text: {{ section.settings.text_color }};
    --kec-media-bg: {{ section.settings.media_bg_color }};
    position: relative;
    width: 100%;
    background-color: var(--kec-bg);
    color: var(--kec-text);
    box-sizing: border-box;
    overflow: hidden;
  }

  #kopilot-explore-confidence-{{ section.id }} *,
  #kopilot-explore-confidence-{{ section.id }} *::before,
  #kopilot-explore-confidence-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #kopilot-explore-confidence-{{ section.id }} .kec-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 98px;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }

  #kopilot-explore-confidence-{{ section.id }} .kec-media {
    position: relative;
    flex: 0 0 720px;
    width: 720px;
    height: 655px;
    overflow: hidden;
    background-color: var(--kec-media-bg);
  }

  #kopilot-explore-confidence-{{ section.id }} .kec-media video,
  #kopilot-explore-confidence-{{ section.id }} .kec-media img,
  #kopilot-explore-confidence-{{ section.id }} .kec-media .kec-media-el {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #kopilot-explore-confidence-{{ section.id }} .kec-media-el--mobile {
    display: none;
  }

  #kopilot-explore-confidence-{{ section.id }} .kec-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    flex: 0 0 512px;
    width: 512px;
    max-width: 512px;
    color: var(--kec-text);
  }

  /* Heading — beat global h2 / span rules */
  #kopilot-explore-confidence-{{ section.id }} h2.kec-heading,
  #kopilot-explore-confidence-{{ section.id }} h2.kec-heading span {
    margin: 0 !important;
    padding: 0 !important;
    width: 100%;
    font-family: 'Elza', sans-serif !important;
    font-style: normal !important;
    font-weight: 300 !important;
    font-size: 60px !important;
    line-height: 1.06 !important;
    letter-spacing: -1px !important;
    color: var(--kec-text) !important;
    text-align: left !important;
    text-transform: none !important;
    word-break: break-word;
  }

  #kopilot-explore-confidence-{{ section.id }} h2.kec-heading span.kec-heading-em {
    font-weight: 500 !important;
  }

  #kopilot-explore-confidence-{{ section.id }} .kec-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
    width: 100%;
  }

  /* Description — beat global p / rte / span rules */
  #kopilot-explore-confidence-{{ section.id }} .kec-text,
  #kopilot-explore-confidence-{{ section.id }} p.kec-text,
  #kopilot-explore-confidence-{{ section.id }} .kec-text p,
  #kopilot-explore-confidence-{{ section.id }} .kec-text span,
  #kopilot-explore-confidence-{{ section.id }} .kec-text a,
  #kopilot-explore-confidence-{{ section.id }} .kec-text * {
    margin: 0 !important;
    padding: 0 !important;
    max-width: 405px;
    font-family: 'Elza', sans-serif !important;
    font-style: normal !important;
    font-weight: 400 !important;
    font-size: 20px !important;
    line-height: 1.2 !important;
    letter-spacing: 0 !important;
    color: var(--kec-text) !important;
    text-align: left !important;
    text-transform: none !important;
    word-break: break-word;
  }

  #kopilot-explore-confidence-{{ section.id }} .kec-text a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Tagline — beat global p rules */
  #kopilot-explore-confidence-{{ section.id }} p.kec-tagline,
  #kopilot-explore-confidence-{{ section.id }} .kec-tagline {
    margin: 0 !important;
    padding: 0 !important;
    font-family: 'Elza', sans-serif !important;
    font-style: normal !important;
    font-weight: 500 !important;
    font-size: 20px !important;
    line-height: 1.2 !important;
    letter-spacing: 0 !important;
    color: var(--kec-text) !important;
    text-align: left !important;
    text-transform: none !important;
    white-space: pre-line;
  }

  @media screen and (min-width: 768px) and (max-width: 1439px) {
    #kopilot-explore-confidence-{{ section.id }} .kec-inner {
      gap: clamp(40px, 6.806vw, 98px);
      padding: 0 clamp(24px, 3.472vw, 50px);
    }

    #kopilot-explore-confidence-{{ section.id }} .kec-media {
      flex: 0 0 clamp(360px, 50vw, 720px);
      width: clamp(360px, 50vw, 720px);
      height: clamp(360px, 45.486vw, 655px);
    }

    #kopilot-explore-confidence-{{ section.id }} .kec-copy {
      flex: 1 1 auto;
      width: auto;
      max-width: 512px;
      gap: clamp(24px, 2.778vw, 40px);
    }

    #kopilot-explore-confidence-{{ section.id }} h2.kec-heading,
    #kopilot-explore-confidence-{{ section.id }} h2.kec-heading span {
      font-size: clamp(36px, 4.167vw, 60px) !important;
    }

    #kopilot-explore-confidence-{{ section.id }} .kec-text,
    #kopilot-explore-confidence-{{ section.id }} p.kec-text,
    #kopilot-explore-confidence-{{ section.id }} .kec-text p,
    #kopilot-explore-confidence-{{ section.id }} .kec-text span,
    #kopilot-explore-confidence-{{ section.id }} .kec-text *,
    #kopilot-explore-confidence-{{ section.id }} p.kec-tagline,
    #kopilot-explore-confidence-{{ section.id }} .kec-tagline {
      font-size: clamp(16px, 1.389vw, 20px) !important;
    }
  }

  /* Mobile ≤767px — Figma 360px frame */
  @media screen and (max-width: 767px) {
    #kopilot-explore-confidence-{{ section.id }} {
      overflow: visible;
      padding-bottom: 76px;
    }

    #kopilot-explore-confidence-{{ section.id }} .kec-inner {
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 32px;
      max-width: 360px;
      padding: 0;
    }

    #kopilot-explore-confidence-{{ section.id }} .kec-media {
      flex: none;
      width: 100%;
      max-width: 360px;
      height: 327.5px;
    }

    #kopilot-explore-confidence-{{ section.id }} .kec-media-el--desktop {
      display: none;
    }

    #kopilot-explore-confidence-{{ section.id }} .kec-media-el--mobile,
    #kopilot-explore-confidence-{{ section.id }} .kec-media-el--desktop.kec-media-el--only {
      display: block;
    }

    #kopilot-explore-confidence-{{ section.id }} .kec-copy {
      align-items: center;
      flex: none;
      width: 100%;
      max-width: 360px;
      gap: 25px;
      text-align: center;
    }

    #kopilot-explore-confidence-{{ section.id }} h2.kec-heading,
    #kopilot-explore-confidence-{{ section.id }} h2.kec-heading span {
      font-size: 30px !important;
      line-height: 1.06 !important;
      letter-spacing: -1px !important;
      text-align: center !important;
    }

    #kopilot-explore-confidence-{{ section.id }} .kec-body {
      align-items: center;
    }

    #kopilot-explore-confidence-{{ section.id }} .kec-text,
    #kopilot-explore-confidence-{{ section.id }} p.kec-text,
    #kopilot-explore-confidence-{{ section.id }} .kec-text p,
    #kopilot-explore-confidence-{{ section.id }} .kec-text span,
    #kopilot-explore-confidence-{{ section.id }} .kec-text * {
      max-width: 340px;
      font-size: 16px !important;
      line-height: 1.2 !important;
      text-align: center !important;
    }

    #kopilot-explore-confidence-{{ section.id }} p.kec-tagline,
    #kopilot-explore-confidence-{{ section.id }} .kec-tagline {
      font-size: 16px !important;
      line-height: 1.2 !important;
      text-align: center !important;
    }
  }
{% endstyle %}

{%- liquid
  assign kec_video = section.settings.media_video
  assign kec_img = section.settings.image_desktop
  assign kec_img_mobile = section.settings.image_mobile
  if kec_img_mobile == blank
    assign kec_img_mobile = kec_img
  endif
-%}

<section
  class="full-width{% if section.settings.extra_class != blank %} {{ section.settings.extra_class | strip | escape }}{% endif %}"
  id="kopilot-explore-confidence-{{ section.id }}"
>
  <div class="kec-inner">
    <div class="kec-media">
      {% if kec_video != blank %}
        {{
          kec_video
          | video_tag:
            class: 'kec-media-el',
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            image_size: '1440x',
            preload: 'metadata'
        }}
      {% elsif kec_img != blank %}
        {% if section.settings.image_mobile != blank %}
          <img
            class="kec-media-el kec-media-el--desktop"
            src="{{ kec_img | image_url: width: 1440 }}"
            alt=""
            loading="lazy"
            width="720"
            height="655"
          >
          <img
            class="kec-media-el kec-media-el--mobile"
            src="{{ kec_img_mobile | image_url: width: 720 }}"
            alt=""
            loading="lazy"
            width="360"
            height="328"
          >
        {% else %}
          <img
            class="kec-media-el kec-media-el--desktop kec-media-el--only"
            src="{{ kec_img | image_url: width: 1440 }}"
            alt="{{ section.settings.heading_line_1 | escape }} {{ section.settings.heading_line_2 | escape }}"
            loading="lazy"
            width="720"
            height="655"
          >
        {% endif %}
      {% endif %}
    </div>

    <div class="kec-copy">
      {% if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank %}
        <h2 class="kec-heading">
          {% if section.settings.heading_line_1 != blank %}
            <span>{{ section.settings.heading_line_1 | escape }}</span>
          {% endif %}
          {% if section.settings.heading_line_1 != blank and section.settings.heading_line_2 != blank %}
            <br>
          {% endif %}
          {% if section.settings.heading_line_2 != blank %}
            <span class="kec-heading-em">{{ section.settings.heading_line_2 | escape }}</span>
          {% endif %}
        </h2>
      {% endif %}

      <div class="kec-body">
        {% if section.settings.text != blank %}
          <div class="kec-text">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.tagline != blank %}
          <p class="kec-tagline">{{ section.settings.tagline | escape | newline_to_br }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Explore with Confidence",
  "tag": "section",
  "class": "section-kopilot-explore-confidence",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "media_video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Image / GIF (desktop)",
      "info": "Used when no video is set."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image / GIF (mobile)",
      "info": "Optional. Falls back to desktop image."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "media_bg_color",
      "label": "Media placeholder color",
      "default": "#F5F5F5"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Explore with"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "Confidence"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Quick access to your unique health information can be critical in an emergency. KOPILOT.ID uses NFC technology combined with simple-to-use AI to provide you with peace of mind and those helping you with details that may save your life.</p>"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Explore with Confidence.\nWe've got your back!"
    },
    {
      "type": "text",
      "id": "extra_class",
      "label": "Extra class",
      "info": "Optional CSS class for this section instance (e.g. explore-app). Use in Custom CSS to style one page without affecting another."
    }
  ],
  "presets": [
    {
      "name": "Explore with Confidence"
    }
  ]
}
{% endschema %}
