{{ 'Elza.css' | asset_url | stylesheet_tag }}
{{ 'section-emergency.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign logo = section.settings.logo
  assign title_image = section.settings.title_image
  assign cta_icon = section.settings.cta_icon
  assign tag_image = section.settings.tag_image
  assign cta_label = section.settings.cta_label | default: 'GET KOPILOT.ID'
  assign cta_url = section.settings.cta_url
  if cta_url == blank
    assign cta_url = routes.root_url
  endif
-%}

<section class="emergency-banner" data-emergency-banner>
  <header class="emergency-banner__header">
    {%- comment -%} Left — logo image {%- endcomment -%}
    <a class="emergency-banner__logo" href="{{ routes.root_url }}">
      {%- if logo != blank -%}
        {{
          logo
          | image_url: height: 80
          | image_tag:
            class: 'emergency-banner__logo-img',
            loading: 'eager',
            alt: shop.name,
            widths: '120, 160, 240',
            sizes: '(max-width: 767px) 110px, 140px'
        }}
      {%- endif -%}
    </a>

    {%- comment -%} Mid — MEDICAL ID image (desktop header only) {%- endcomment -%}
    {%- if title_image != blank -%}
      <div class="emergency-banner__title emergency-banner__title--header">
        {{
          title_image
          | image_url: height: 120
          | image_tag:
            class: 'emergency-banner__title-img',
            loading: 'eager',
            alt: 'Medical ID',
            widths: '200, 320, 480',
            sizes: '(max-width: 767px) 0px, 280px'
        }}
      </div>
    {%- endif -%}

    {%- comment -%} Right — CTA text + uploadable cart/icon {%- endcomment -%}
    <div class="emergency-banner__cta-group">
      {%- if cta_label != blank -%}
        <a class="emergency-banner__cta-text" href="{{ cta_url }}">{{ cta_label | escape }}</a>
      {%- endif -%}
      {%- if cta_icon != blank -%}
        <a class="emergency-banner__cta-icon" href="{{ cta_url }}" aria-label="{{ cta_label | escape }}">
          {{
            cta_icon
            | image_url: width: 64
            | image_tag:
              class: 'emergency-banner__cta-icon-img',
              loading: 'eager',
              alt: '',
              widths: '32, 48, 64',
              sizes: '24px'
          }}
        </a>
      {%- endif -%}
    </div>
  </header>

  {%- comment -%} Mobile hero: MEDICAL ID image + red K {%- endcomment -%}
  <div class="emergency-banner__hero">
    {%- if title_image != blank -%}
      <div class="emergency-banner__title emergency-banner__title--hero">
        {{
          title_image
          | image_url: height: 160
          | image_tag:
            class: 'emergency-banner__title-img',
            loading: 'eager',
            alt: 'Medical ID',
            widths: '240, 360, 480',
            sizes: '(max-width: 767px) 240px, 0px'
        }}
      </div>
    {%- else -%}
      <h1 class="visually-hidden">Medical ID</h1>
    {%- endif -%}

    <a class="emergency-banner__tag emergency-banner__tag--hero" href="{{ cta_url }}" aria-label="{{ cta_label | escape }}">
      {%- if tag_image != blank -%}
        {{
          tag_image
          | image_url: width: 220
          | image_tag: class: 'emergency-banner__tag-img', loading: 'eager', alt: '', widths: '110, 160, 220', sizes: '(max-width: 767px) 56px, 110px'
        }}
      {%- else -%}
        <img
          class="emergency-banner__tag-img"
          src="{{ 'tagbutton.svg' | asset_url }}"
          alt=""
          width="110"
          height="110"
        >
      {%- endif -%}
    </a>
  </div>

  {%- comment -%} Desktop floating red K {%- endcomment -%}
  <a class="emergency-banner__tag emergency-banner__tag--desktop" href="{{ cta_url }}" aria-label="{{ cta_label | escape }}">
    {%- if tag_image != blank -%}
      {{
        tag_image
        | image_url: width: 220
        | image_tag: class: 'emergency-banner__tag-img', loading: 'eager', alt: '', widths: '110, 160, 220', sizes: '110px'
      }}
    {%- else -%}
      <img
        class="emergency-banner__tag-img"
        src="{{ 'tagbutton.svg' | asset_url }}"
        alt=""
        width="110"
        height="110"
      >
    {%- endif -%}
  </a>
</section>

{% schema %}
{
  "name": "Emergency Banner",
  "tag": "div",
  "class": "section-emergency-banner",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Left logo image"
    },
    {
      "type": "image_picker",
      "id": "title_image",
      "label": "Center title image (MEDICAL ID)"
    },
    {
      "type": "image_picker",
      "id": "cta_icon",
      "label": "Right icon (cart)"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA text",
      "default": "GET KOPILOT.ID"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "header",
      "content": "Tag"
    },
    {
      "type": "image_picker",
      "id": "tag_image",
      "label": "Red K / tag button image"
    }
  ],
  "presets": [
    {
      "name": "Emergency Banner"
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header"]
  }
}
{% endschema %}
