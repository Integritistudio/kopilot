{{ 'Elza.css' | asset_url | stylesheet_tag }}
{{ 'emergency.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_image = section.settings.bg_image
  assign mobile_image = section.settings.mobile_image
  assign logo = section.settings.logo
  assign cta_label = section.settings.cta_label | default: 'GET KOPILOT.ID'
  assign cta_url = section.settings.cta_url
-%}

<section class="emergency-banner" data-emergency-banner>
  <div class="emergency-banner__bg" aria-hidden="true">
    <picture>
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 767px)"
          srcset="{{ mobile_image | image_url: width: 900 }}"
        >
      {%- endif -%}
      {%- if bg_image != blank -%}
        {{
          bg_image
          | image_url: width: 2880
          | image_tag:
            class: 'emergency-banner__bg-img',
            loading: 'eager',
            widths: '1440, 1920, 2400, 2880',
            sizes: '100vw',
            alt: ''
        }}
      {%- elsif mobile_image != blank -%}
        {{
          mobile_image
          | image_url: width: 900
          | image_tag: class: 'emergency-banner__bg-img', loading: 'eager', alt: ''
        }}
      {%- endif -%}
    </picture>
  </div>

  <header class="emergency-banner__header">
    <a class="emergency-banner__logo" href="{{ routes.root_url }}">
      {%- comment -%}
        Figma header logo is wordmark text (KOPILOT + red ID), not the MEDICAL ID heading asset.
      {%- endcomment -%}
      <span class="emergency-banner__logo-mark" aria-label="KOPILOT.ID">
        <span class="emergency-banner__logo-dot" aria-hidden="true"></span>
        <span class="emergency-banner__logo-name">KOPILOT</span><span class="emergency-banner__logo-id">.ID</span>
      </span>
    </a>

    <p class="emergency-banner__page-title" aria-hidden="true">
      <span class="emergency-banner__page-title-solid">MEDICAL</span>
      <span class="emergency-banner__page-title-outline">ID</span>
    </p>
    <h1 class="visually-hidden">Medical ID</h1>

    <a
      class="emergency-banner__cta"
      href="{% if cta_url != blank %}{{ cta_url }}{% else %}{{ routes.root_url }}{% endif %}"
    >
      <span class="emergency-banner__cta-text">{{ cta_label | escape }}</span>
      <span class="emergency-banner__cta-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="11" cy="11" r="11" fill="#F20008"/>
          <path d="M11 5.5V11" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
          <path d="M7.2 8.2a5.2 5.2 0 1 0 7.6 0" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </span>
    </a>
  </header>

  <a
    class="emergency-banner__tag"
    href="{% if cta_url != blank %}{{ cta_url }}{% else %}{{ routes.root_url }}{% endif %}"
    aria-label="{{ cta_label | escape }}"
  >
    <img src="{{ 'tagbutton.svg' | asset_url }}" alt="" width="110" height="110">
  </a>
</section>

{% schema %}
{
  "name": "Emergency Banner",
  "tag": "div",
  "class": "section-emergency-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Desktop background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Header CTA label",
      "default": "GET KOPILOT.ID"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Heading image (legacy)"
    }
  ],
  "presets": [
    {
      "name": "Emergency Banner"
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header"]
  }
}
{% endschema %}
