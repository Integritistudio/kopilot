{{ 'Elza.css' | asset_url | stylesheet_tag }}

{% style %}
  .kah-{{ section.id }} {
    --kah-bg: {{ section.settings.bg_color }};
    --kah-text: {{ section.settings.text_color }};
    --kah-btn-bg: {{ section.settings.button_color }};
    --kah-btn-text: {{ section.settings.button_text_color }};
    position: relative;
    width: 100%;
    min-height: 819.27px;
    background-color: var(--kah-bg);
    color: var(--kah-text);
    box-sizing: border-box;
    overflow: hidden;
  }

  .kah-{{ section.id }} *,
  .kah-{{ section.id }} *::before,
  .kah-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  .kah-{{ section.id }} .kah-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .kah-{{ section.id }} .kah-bg-img {
    position: absolute;
    left: 50%;
    top: -359px;
    width: 1488px;
    height: 1913px;
    max-width: none;
    transform: translateX(-50%);
    object-fit: cover;
    display: block;
  }

  .kah-{{ section.id }} .kah-bg-img--mobile {
    display: none;
  }

  .kah-{{ section.id }} .kah-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(107.9deg, rgba(0, 0, 0, 0.5) 38.3%, rgba(0, 0, 0, 0) 72.228%);
  }

  .kah-{{ section.id }} .kah-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    padding: 37px 111px 0;
  }

  .kah-{{ section.id }} .kah-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .kah-{{ section.id }} .kah-logo {
    display: block;
    width: 172px;
    height: 19px;
    flex-shrink: 0;
    line-height: 0;
  }

  .kah-{{ section.id }} .kah-logo img {
    display: block;
    width: 172px;
    height: 19px;
    object-fit: contain;
  }

  .kah-{{ section.id }} .kah-header-cta {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--kah-text);
  }

  .kah-{{ section.id }} .kah-header-cta-label {
    margin: 0;
    padding: 0 16px 0 0;
    font-family: 'Elza', sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: normal;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: inherit;
    white-space: nowrap;
  }

  .kah-{{ section.id }} .kah-header-icon {
    display: block;
    width: 24.02px;
    height: 24px;
    flex-shrink: 0;
    overflow: hidden;
  }

  .kah-{{ section.id }} .kah-header-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .kah-{{ section.id }} .kah-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 41px;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 167px 104px 127px;
  }

  .kah-{{ section.id }} .kah-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    width: 100%;
    color: var(--kah-text);
  }

  .kah-{{ section.id }} .kah-heading {
    margin: 0;
    padding: 0;
    width: 100%;
    font-family: 'Elza', sans-serif;
    font-weight: 300;
    font-size: 120px;
    line-height: 116px;
    letter-spacing: -4.86px;
    color: var(--kah-text);
    word-break: break-word;
  }

  .kah-{{ section.id }} .kah-subcopy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    width: 316px;
    max-width: 100%;
  }

  .kah-{{ section.id }} .kah-product {
    margin: 0;
    padding: 0;
    width: 160px;
    font-family: 'Elza', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.2;
    color: var(--kah-text);
  }

  .kah-{{ section.id }} .kah-started {
    margin: 0;
    padding: 0;
    width: 100%;
    font-family: 'Elza', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.2;
    color: var(--kah-text);
  }

  .kah-{{ section.id }} .kah-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .kah-{{ section.id }} .kah-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 18.344px 64px;
    min-height: 60.69px;
    background-color: var(--kah-btn-bg);
    border: 0;
    border-radius: 0;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.25s ease;
  }

  .kah-{{ section.id }} .kah-btn:hover {
    opacity: 0.9;
  }

  .kah-{{ section.id }} .kah-btn-text {
    font-family: 'Elza', sans-serif;
    font-weight: 600;
    font-size: 20.383px;
    line-height: normal;
    text-transform: uppercase;
    color: var(--kah-btn-text);
    white-space: nowrap;
  }

  .kah-{{ section.id }} .kah-stores {
    display: flex;
    align-items: center;
    gap: 30px;
    padding-top: 5.364px;
  }

  .kah-{{ section.id }} .kah-store {
    display: block;
    line-height: 0;
    text-decoration: none;
  }

  .kah-{{ section.id }} .kah-store--google {
    width: 101.064px;
    height: 30.215px;
  }

  .kah-{{ section.id }} .kah-store--apple {
    width: 89.604px;
    height: 30.215px;
  }

  .kah-{{ section.id }} .kah-store img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media screen and (min-width: 768px) and (max-width: 1439px) {
    .kah-{{ section.id }} {
      min-height: clamp(624px, 56.894vw, 819.27px);
    }

    .kah-{{ section.id }} .kah-header {
      padding: 37px clamp(40px, 7.708vw, 111px) 0;
    }

    .kah-{{ section.id }} .kah-inner {
      gap: clamp(29px, 2.847vw, 41px);
      padding: clamp(127px, 11.597vw, 167px) clamp(40px, 7.222vw, 104px) clamp(100px, 8.819vw, 127px);
    }

    .kah-{{ section.id }} .kah-heading {
      font-size: clamp(50px, 8.333vw, 120px);
      line-height: clamp(50px, 8.056vw, 116px);
      letter-spacing: clamp(-2.4px, -0.338vw, -4.86px);
    }

    .kah-{{ section.id }} .kah-product,
    .kah-{{ section.id }} .kah-started {
      font-size: clamp(16px, 1.389vw, 20px);
    }

    .kah-{{ section.id }} .kah-btn {
      min-height: clamp(49.76px, 4.215vw, 60.69px);
      padding: clamp(15.88px, 1.274vw, 18.344px) clamp(48px, 4.444vw, 64px);
    }

    .kah-{{ section.id }} .kah-btn-text {
      font-size: clamp(15px, 1.415vw, 20.383px);
    }

    .kah-{{ section.id }} .kah-stores {
      gap: clamp(12.342px, 2.083vw, 30px);
    }

    .kah-{{ section.id }} .kah-store--google {
      width: clamp(101.064px, 7.018vw, 110.07px);
      height: clamp(30.215px, 2.098vw, 32.908px);
    }

    .kah-{{ section.id }} .kah-store--apple {
      width: clamp(89.604px, 6.222vw, 97.589px);
      height: clamp(30.215px, 2.098vw, 32.908px);
    }
  }

  @media screen and (max-width: 767px) {
    .kah-{{ section.id }} {
      min-height: 623.77px;
    }

    .kah-{{ section.id }} .kah-bg-img--desktop {
      display: none;
    }

    .kah-{{ section.id }} .kah-bg-img--mobile {
      display: block;
      left: calc(50% + 40.39px);
      top: 50%;
      width: 521px;
      height: 670px;
      transform: translate(-50%, -50%);
    }

    .kah-{{ section.id }} .kah-header {
      justify-content: center;
      padding: 35px 0 0;
    }

    .kah-{{ section.id }} .kah-header-inner {
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      width: 172px;
      height: 58px;
    }

    .kah-{{ section.id }} .kah-inner {
      align-items: center;
      gap: 29px;
      max-width: 360px;
      padding: 127px 26px;
    }

    .kah-{{ section.id }} .kah-copy {
      align-items: center;
      text-align: center;
    }

    .kah-{{ section.id }} .kah-heading {
      font-size: 50px;
      line-height: 1;
      letter-spacing: -4.86px;
      text-align: center;
    }

    .kah-{{ section.id }} .kah-subcopy {
      align-items: center;
      width: 316px;
    }

    .kah-{{ section.id }} .kah-product,
    .kah-{{ section.id }} .kah-started {
      text-align: center;
    }

    .kah-{{ section.id }} .kah-actions {
      align-items: center;
      gap: 15px;
      padding-top: 7.1px;
      max-width: 274.51px;
      width: 100%;
    }

    .kah-{{ section.id }} .kah-btn {
      width: 100%;
      min-width: 274.51px;
      min-height: 49.76px;
      padding: 15.88px 61.756px;
    }

    .kah-{{ section.id }} .kah-btn-text {
      font-size: 15px;
    }

    .kah-{{ section.id }} .kah-stores {
      gap: 12.342px;
      padding-top: 0;
      width: 220px;
      justify-content: flex-start;
    }

    .kah-{{ section.id }} .kah-store--google {
      width: 110.07px;
      height: 32.908px;
    }

    .kah-{{ section.id }} .kah-store--apple {
      width: 97.589px;
      height: 32.908px;
    }
  }
{% endstyle %}

{% assign kah_logo = section.settings.logo %}
{% assign kah_icon = section.settings.header_icon %}
{% assign kah_google = section.settings.google_play_badge %}
{% assign kah_apple = section.settings.app_store_badge %}
{% assign kah_img_desktop = section.settings.image_desktop %}
{% assign kah_img_mobile = section.settings.image_mobile %}
{% if kah_img_mobile == blank %}
  {% assign kah_img_mobile = kah_img_desktop %}
{% endif %}

<section class="kah-{{ section.id }}" id="kopilot-app-download-hero">
  <div class="kah-bg" aria-hidden="true">
    {% if kah_img_desktop != blank %}
      <img
        class="kah-bg-img kah-bg-img--desktop"
        src="{{ kah_img_desktop | image_url: width: 2880 }}"
        alt=""
        loading="eager"
        width="1440"
        height="819"
      >
    {% endif %}

    {% if kah_img_mobile != blank %}
      <img
        class="kah-bg-img kah-bg-img--mobile"
        src="{{ kah_img_mobile | image_url: width: 1080 }}"
        alt=""
        loading="eager"
        width="360"
        height="624"
      >
    {% endif %}

    <div class="kah-bg-overlay"></div>
  </div>

  {% if section.settings.show_header %}
    <header class="kah-header">
      <div class="kah-header-inner">
        {% if kah_logo != blank %}
          <a class="kah-logo" href="{{ section.settings.logo_link | default: routes.root_url }}" aria-label="{{ shop.name }}">
            <img
              src="{{ kah_logo | image_url: width: 344 }}"
              alt="{{ shop.name }}"
              loading="eager"
              width="172"
              height="19"
            >
          </a>
        {% endif %}

        {% if section.settings.header_cta_label != blank %}
          <a class="kah-header-cta" href="{{ section.settings.header_cta_link | default: '#' }}">
            <span class="kah-header-cta-label">{{ section.settings.header_cta_label | escape }}</span>
            {% if kah_icon != blank %}
              <span class="kah-header-icon" aria-hidden="true">
                <img
                  src="{{ kah_icon | image_url: width: 48 }}"
                  alt=""
                  loading="eager"
                  width="24"
                  height="24"
                >
              </span>
            {% endif %}
          </a>
        {% endif %}
      </div>
    </header>
  {% endif %}

  <div class="kah-inner">
    <div class="kah-copy">
      {% if section.settings.heading != blank %}
        <h1 class="kah-heading">{{ section.settings.heading | newline_to_br }}</h1>
      {% endif %}

      <div class="kah-subcopy">
        {% if section.settings.product_label != blank %}
          <div class="kah-product">{{ section.settings.product_label | newline_to_br }}</div>
        {% endif %}

        {% if section.settings.started_text != blank %}
          <p class="kah-started">{{ section.settings.started_text | escape }}</p>
        {% endif %}
      </div>
    </div>

    <div class="kah-actions">
      {% if section.settings.button_label != blank %}
        <a class="kah-btn" href="{{ section.settings.button_link | default: '#' }}">
          <span class="kah-btn-text">{{ section.settings.button_label | escape }}</span>
        </a>
      {% endif %}

      {% if kah_google != blank or kah_apple != blank %}
        <div class="kah-stores">
          {% if kah_google != blank %}
            <a
              class="kah-store kah-store--google"
              href="{{ section.settings.google_play_link | default: '#' }}"
              {% if section.settings.google_play_link != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
              aria-label="Get it on Google Play"
            >
              <img
                src="{{ kah_google | image_url: width: 220 }}"
                alt="Get it on Google Play"
                loading="lazy"
                width="101"
                height="30"
              >
            </a>
          {% endif %}

          {% if kah_apple != blank %}
            <a
              class="kah-store kah-store--apple"
              href="{{ section.settings.app_store_link | default: '#' }}"
              {% if section.settings.app_store_link != blank %}target="_blank" rel="noopener noreferrer"{% endif %}
              aria-label="Download on the App Store"
            >
              <img
                src="{{ kah_apple | image_url: width: 196 }}"
                alt="Download on the App Store"
                loading="lazy"
                width="90"
                height="30"
              >
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>
