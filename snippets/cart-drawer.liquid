<cart-drawer>
  <div
    class="drawer_wrapper cart_drawer_wrapper color-{{ settings.drawer_color_scheme }}"
    id="cart_drawer"
    inert
    aria-hidden="true">
    <div class="drawer_wrapper_inner cart_drawer_inner" tabindex="-1">
      <div class="cart_drawer_confetti_layer" aria-hidden="true"></div>

      <div class="drawer_header cart_drawer_header">
        <h2 class="cart_drawer_heading">Your Cart</h2>

        <div class="drawer_close_btn_wrapper">
          <button class="drawer_close_btn has_custom_icon" aria-label="{{ 'accessibility.close' | t }}">
            <img
              class="drawer_close_btn_icon"
              src="https://cdn.shopify.com/s/files/1/0598/6471/1277/files/Group_2106667234_2.svg?v=1784920802"
              width="28"
              height="28"
              alt=""
              loading="lazy"
            >
          </button>
        </div>
      </div>

      {% if cart != empty %}
        {% render 'free-shipping-bar' %}
      {% endif %}

      <div class="cart_drawer_content_wrapper" data-lenis-prevent>
        {% if cart == empty %}
          <div class="empty_cart_drawer_wrapper">
            <h3 class="h4">{{ 'drawers.cart_drawer.empty_drawer_heading' | t }}</h3>
            <a
              class="btn"
              href="{{ settings.continue_shopping_url | default: routes.all_products_collection_url }}"
              aria-label="{{ 'general.continue_shopping' | t }}">
              {{- 'general.continue_shopping' | t -}}
            </a>
          </div>
        {% else %}
          <div class="cart_drawer_body">
            <div class="cart_drawer_content_inner">
              {% for item in cart.items %}
                {%- liquid
                  assign cart_img = item.image
                  if item.product.featured_image != blank
                    assign cart_img = item.product.featured_image
                  endif
                  if item.product.images.size > 0
                    assign cart_img = item.product.images.first
                  endif

                  assign pack_qty = 1
                  assign has_pack_label = false
                  if item.variant.metafields.custom.quantity != blank
                    assign pack_qty = item.variant.metafields.custom.quantity | plus: 0
                    assign has_pack_label = true
                  else
                    assign title_downcase = item.variant.title | downcase
                    if title_downcase contains 'set of 3' or title_downcase contains '3 tag' or title_downcase contains '3-pack' or title_downcase contains '3 pack' or title_downcase contains '3 product'
                      assign pack_qty = 3
                      assign has_pack_label = true
                    elsif title_downcase contains 'set of 2' or title_downcase contains '2 tag' or title_downcase contains '2-pack' or title_downcase contains '2 pack' or title_downcase contains '2 product'
                      assign pack_qty = 2
                      assign has_pack_label = true
                    elsif title_downcase contains '1 tag' or title_downcase contains '1 product'
                      assign pack_qty = 1
                      assign has_pack_label = true
                    elsif title_downcase contains '3'
                      assign pack_qty = 3
                      assign has_pack_label = true
                    elsif title_downcase contains '2'
                      assign pack_qty = 2
                      assign has_pack_label = true
                    endif
                  endif
                -%}

                <div class="cart_drawer_item_block" data-pack-qty="{{ pack_qty }}">
                  <div class="cdi_block_inner">
                    <div class="cart_drawer_item_img_block">
                      <a href="{{ item.url }}" aria-label="{{ item.product.title | escape }}"></a>
                      {% if cart_img != blank %}
                        {{ cart_img | image_url: width: 400 | image_tag: loading: 'lazy', alt: item.product.title }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder_svg' }}
                      {% endif %}
                      <div class="cart_drawer_item_badge" aria-hidden="true">
                        Special offer. Save up to 20% on multi-packs.
                      </div>
                    </div>

                    <div class="cart_drawer_item_info_block">
                      <div class="cdi_top_row">
                        <div class="cdi_title">
                          <p>
                            <a href="{{ item.url }}">The piece of gear you don't think about until you need it.</a>
                          </p>
                        </div>
                        <div class="cdi_price">
                          {% if item.original_price != item.final_price %}
                            <div class="cdi_price_inner">
                              <span>{{ item.final_price | money }}</span>
                              <s>{{ item.original_price | money }}</s>
                            </div>
                          {% else %}
                            <div class="cdi_price_inner">
                              <span>{{ item.final_price | money }}</span>
                              {% if item.variant.compare_at_price != blank
                                and item.variant.compare_at_price > item.variant.price
                              %}
                                <s>{{ item.variant.compare_at_price | money }}</s>
                              {% endif %}
                            </div>
                          {% endif %}
                        </div>
                      </div>

                      <div class="cdi_mid_row">
                        <div class="cdi_options_wrapper">
                          {% if has_pack_label %}
                            <p class="cdi_product_options">
                              <span>
                                {%- if pack_qty == 1 -%}
                                  1 Product
                                {%- else -%}
                                  {{ pack_qty }} Products
                                {%- endif -%}
                              </span>
                            </p>
                          {% elsif item.product.has_only_default_variant %}
                            <p class="cdi_product_options">
                              <span>{{ item.quantity }} {% if item.quantity == 1 %}Product{% else %}Products{% endif %}</span>
                            </p>
                          {% else %}
                            <p class="cdi_product_options">
                              {% for option in item.options_with_values %}
                                <span>{{- option.value | replace: 'product', 'Product' -}}</span>
                              {% endfor %}
                            </p>
                          {% endif %}

                          {% if item.properties.size != 0 %}
                            {%- for property in item.properties -%}
                              {%- assign property_first_char = property.first | slice: 0 -%}
                              {%- if property.last != blank and property_first_char != '_' -%}
                                <div class="cdi_properties_wrapper">
                                  <div class="cdi_property_name">{{ property.first }}:</div>
                                  <div class="cdi_property_value">
                                    {%- if property.last contains '/uploads/' -%}
                                      <a href="{{ property.last }}" class="link" target="_blank">
                                        {{ property.last | split: '/' | last }}
                                      </a>
                                    {%- else -%}
                                      {{ property.last }}
                                    {%- endif -%}
                                  </div>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          {% endif %}

                          {% if item.selling_plan_allocation != null %}
                            <p class="cdi_selling_plan">
                              {{ item.selling_plan_allocation.selling_plan.name }}
                            </p>
                          {% endif %}
                        </div>

                        <div class="cdi_item_remove">
                          <item-remove data-line="{{ forloop.index }}">
                            <a
                              aria-label="{{- 'drawers.cart_drawer.remove' | t -}}"
                              class="item_remove_btn"
                              href="{{ item.url_to_remove }}"
                              data-remove
                              data-quantity="0">
                              {{ 'icon-trash.svg' | inline_asset_content }}
                            </a>
                          </item-remove>
                        </div>
                      </div>

                      <div class="cdi_quantity_picker">
                        <cart-quantity-picker data-line="{{ forloop.index }}">
                          <button
                            type="button"
                            class="btn_minus"
                            data-minus
                            aria-label="{{ 'products.product.quantity_decrease' | t }}"
                            data-quantity="{{ item.quantity | minus: 1 }}"
                            data-min="{{ item.quantity }} - {{ item.variant.quantity_rule.min }}"
                            {% if item.quantity == item.variant.quantity_rule.min %}
                            disabled
                            {% endif %}>
                            <svg class="cq_icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                              <path d="M2.5 6h7" stroke="#000" stroke-width="1.25" stroke-linecap="square"/>
                            </svg>
                          </button>

                          <input
                            type="text"
                            name="quantity"
                            min="{{ item.variant.quantity_rule.min }}"
                            data-min="{{ item.variant.quantity_rule.min }}"
                            {% if item.variant.quantity_rule.max %}
                            data-max="{{ item.variant.quantity_rule.max }}"
                            max="{{ item.variant.quantity_rule.max }}"
                            {% endif %}
                            step="{{ item.variant.quantity_rule.increment }}"
                            value="{{ item.quantity }}"
                            id="Item_quantity-{{ forloop.index }}">
                          <label class="visually-hidden" for="Item_quantity-{{ forloop.index }}">
                            {{- 'products.product.quantity' | t -}}
                          </label>

                          <button
                            type="button"
                            aria-label="{{ 'products.product.quantity_increase' | t }}"
                            class="btn_plus"
                            data-plus
                            data-quantity="{{ item.quantity | plus: 1 }}"
                            {% if item.quantity == item.variant.quantity_rule.max %}
                            disabled
                            {% endif %}>
                            <svg class="cq_icon" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                              <path d="M2.5 6h7M6 2.5v7" stroke="#000" stroke-width="1.25" stroke-linecap="square"/>
                            </svg>
                          </button>
                        </cart-quantity-picker>
                      </div>
                    </div>
                  </div>

                  <div
                    class="cart_drawer_error"
                    data-line="{{ forloop.index }}"
                    hidden>
                    A maximum of 5 items are added due to availability.
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>

          <div class="cart_drawer_footer">
            <div class="cart_drawer_footer_inner">
              {%- comment -%}
                Pack upsell (static Theme Editor cards):
                - 1 Tag → Card 1 upgrades to Set of 2, Card 2 upgrades to Set of 3
                - Set of 2 → one card upgrades to Set of 3
                - Set of 3 / total tags >= 3 → hide upsell
              {%- endcomment -%}
              {%- liquid
                assign upsell_item = nil
                assign total_tags = 0
                assign has_set_of_3 = false
                assign is_qty_pack_setup = false
                assign set_of_2_variant = nil
                assign set_of_3_variant = nil

                for item in cart.items
                  if upsell_item == nil
                    assign upsell_item = item
                  endif

                  assign seen_1 = false
                  assign seen_2 = false
                  assign seen_3 = false
                  assign distinct_packs = 0

                  for v in item.product.variants
                    assign vq = 1
                    if v.metafields.custom.quantity != blank
                      assign vq = v.metafields.custom.quantity | plus: 0
                    else
                      assign vtd = v.title | downcase
                      if vtd contains 'set of 3' or vtd contains '3 tag' or vtd contains '3-pack' or vtd contains '3 pack' or vtd contains '3 product'
                        assign vq = 3
                      elsif vtd contains 'set of 2' or vtd contains '2 tag' or vtd contains '2-pack' or vtd contains '2 pack' or vtd contains '2 product'
                        assign vq = 2
                      elsif vtd contains '1 tag' or vtd contains '1 product' or vtd == 'default title'
                        assign vq = 1
                      elsif vtd contains '3'
                        assign vq = 3
                      elsif vtd contains '2'
                        assign vq = 2
                      endif
                    endif
                    if vq == 1 and seen_1 == false
                      assign seen_1 = true
                      assign distinct_packs = distinct_packs | plus: 1
                    endif
                    if vq == 2 and seen_2 == false
                      assign seen_2 = true
                      assign distinct_packs = distinct_packs | plus: 1
                    endif
                    if vq == 3 and seen_3 == false
                      assign seen_3 = true
                      assign distinct_packs = distinct_packs | plus: 1
                    endif
                  endfor

                  if item.product.has_only_default_variant or item.product.variants.size <= 1 or distinct_packs <= 1
                    assign is_qty_pack_setup = true
                    assign item_total = item.quantity
                  else
                    assign variant_pack = 1
                    if item.variant.metafields.custom.quantity != blank
                      assign variant_pack = item.variant.metafields.custom.quantity | plus: 0
                    else
                      assign td = item.variant.title | downcase
                      if td contains 'set of 3' or td contains '3 tag' or td contains '3-pack' or td contains '3 pack' or td contains '3 product'
                        assign variant_pack = 3
                      elsif td contains 'set of 2' or td contains '2 tag' or td contains '2-pack' or td contains '2 pack' or td contains '2 product'
                        assign variant_pack = 2
                      elsif td contains '3'
                        assign variant_pack = 3
                      elsif td contains '2'
                        assign variant_pack = 2
                      endif
                    endif
                    if variant_pack >= 3
                      assign has_set_of_3 = true
                    endif
                    assign item_total = variant_pack | times: item.quantity
                  endif

                  assign total_tags = total_tags | plus: item_total
                endfor

                assign upsell_tier = 0
                if has_set_of_3 or total_tags >= 3
                  assign upsell_tier = 3
                elsif total_tags == 2
                  assign upsell_tier = 2
                elsif total_tags == 1
                  assign upsell_tier = 1
                endif

                if upsell_item != nil and upsell_tier > 0 and upsell_tier < 3 and is_qty_pack_setup == false
                  for v in upsell_item.product.variants
                    assign vq = 1
                    if v.metafields.custom.quantity != blank
                      assign vq = v.metafields.custom.quantity | plus: 0
                    else
                      assign vtd = v.title | downcase
                      if vtd contains 'set of 3' or vtd contains '3 tag' or vtd contains '3-pack' or vtd contains '3 pack' or vtd contains '3 product'
                        assign vq = 3
                      elsif vtd contains 'set of 2' or vtd contains '2 tag' or vtd contains '2-pack' or vtd contains '2 pack' or vtd contains '2 product'
                        assign vq = 2
                      elsif vtd contains '1 tag' or vtd contains '1 product' or vtd == 'default title'
                        assign vq = 1
                      elsif vtd contains '3'
                        assign vq = 3
                      elsif vtd contains '2'
                        assign vq = 2
                      endif
                    endif
                    if vq == 2 and set_of_2_variant == nil
                      assign set_of_2_variant = v
                    endif
                    if vq == 3 and set_of_3_variant == nil
                      assign set_of_3_variant = v
                    endif
                  endfor
                endif
              -%}

              {%- if upsell_item != nil and upsell_tier > 0 and upsell_tier < 3 -%}
                {%- liquid
                  assign show_upsell = false
                  if is_qty_pack_setup
                    assign show_upsell = true
                  elsif upsell_tier == 1
                    if set_of_2_variant != nil or set_of_3_variant != nil
                      assign show_upsell = true
                    endif
                  elsif upsell_tier == 2
                    if set_of_3_variant != nil
                      assign show_upsell = true
                    endif
                  endif
                -%}
                {%- if show_upsell -%}
                  <div class="cart_drawer_upsell">
                    <div class="cart_drawer_upsell_head">
                      <p class="cart_drawer_upsell_title">
                        {{ settings.cart_upsell_heading | default: 'Save more when you add extra tags.' }}
                      </p>
                    </div>

                    <div class="cart_drawer_upsell_list">
                      {%- if upsell_tier == 1 -%}
                        {%- if is_qty_pack_setup or set_of_2_variant != nil -%}
                          <div class="cart_drawer_upsell_card">
                            <div class="cart_drawer_upsell_copy">
                              <div class="cart_drawer_upsell_label_row">
                                <p class="cart_drawer_upsell_label">{{ settings.cart_upsell_c1_card1_title | default: 'Add 1 tag' }}</p>
                                {%- if settings.cart_upsell_c1_card1_badge != blank -%}
                                  <span class="cart_drawer_upsell_badge">{{ settings.cart_upsell_c1_card1_badge }}</span>
                                {%- endif -%}
                              </div>
                              <p class="cart_drawer_upsell_price">
                                {%- if settings.cart_upsell_c1_card1_price != blank -%}
                                  <span class="cart_drawer_upsell_price_sale">{{ settings.cart_upsell_c1_card1_price }}</span>
                                {%- endif -%}
                                {%- if settings.cart_upsell_c1_card1_compare_price != blank -%}
                                  <s class="cart_drawer_upsell_price_compare">{{ settings.cart_upsell_c1_card1_compare_price }}</s>
                                {%- endif -%}
                              </p>
                            </div>
                            {%- if is_qty_pack_setup -%}
                              <cart-pack-upgrade
                                data-key="{{ upsell_item.key }}"
                                data-variant-id="{{ upsell_item.variant_id }}"
                                data-quantity="2"
                                data-same-variant="true"
                                data-product-id="{{ upsell_item.product.id }}">
                                <button type="button" class="cart_drawer_upsell_btn">{{ settings.cart_upsell_c1_card1_button | default: 'Upgrade' }}</button>
                              </cart-pack-upgrade>
                            {%- else -%}
                              <cart-pack-upgrade
                                data-key="{{ upsell_item.key }}"
                                data-variant-id="{{ set_of_2_variant.id }}"
                                data-quantity="1"
                                data-product-id="{{ upsell_item.product.id }}">
                                <button type="button" class="cart_drawer_upsell_btn">{{ settings.cart_upsell_c1_card1_button | default: 'Upgrade' }}</button>
                              </cart-pack-upgrade>
                            {%- endif -%}
                          </div>
                        {%- endif -%}

                        {%- if is_qty_pack_setup or set_of_3_variant != nil -%}
                          <div class="cart_drawer_upsell_card">
                            <div class="cart_drawer_upsell_copy">
                              <div class="cart_drawer_upsell_label_row">
                                <p class="cart_drawer_upsell_label">{{ settings.cart_upsell_c1_card2_title | default: 'Add 2 tags' }}</p>
                                {%- if settings.cart_upsell_c1_card2_badge != blank -%}
                                  <span class="cart_drawer_upsell_badge">{{ settings.cart_upsell_c1_card2_badge }}</span>
                                {%- endif -%}
                              </div>
                              <p class="cart_drawer_upsell_price">
                                {%- if settings.cart_upsell_c1_card2_price != blank -%}
                                  <span class="cart_drawer_upsell_price_sale">{{ settings.cart_upsell_c1_card2_price }}</span>
                                {%- endif -%}
                                {%- if settings.cart_upsell_c1_card2_compare_price != blank -%}
                                  <s class="cart_drawer_upsell_price_compare">{{ settings.cart_upsell_c1_card2_compare_price }}</s>
                                {%- endif -%}
                              </p>
                            </div>
                            {%- if is_qty_pack_setup -%}
                              <cart-pack-upgrade
                                data-key="{{ upsell_item.key }}"
                                data-variant-id="{{ upsell_item.variant_id }}"
                                data-quantity="3"
                                data-same-variant="true"
                                data-product-id="{{ upsell_item.product.id }}">
                                <button type="button" class="cart_drawer_upsell_btn">{{ settings.cart_upsell_c1_card2_button | default: 'Upgrade' }}</button>
                              </cart-pack-upgrade>
                            {%- else -%}
                              <cart-pack-upgrade
                                data-key="{{ upsell_item.key }}"
                                data-variant-id="{{ set_of_3_variant.id }}"
                                data-quantity="1"
                                data-product-id="{{ upsell_item.product.id }}">
                                <button type="button" class="cart_drawer_upsell_btn">{{ settings.cart_upsell_c1_card2_button | default: 'Upgrade' }}</button>
                              </cart-pack-upgrade>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- elsif upsell_tier == 2 -%}
                        {%- if is_qty_pack_setup or set_of_3_variant != nil -%}
                          <div class="cart_drawer_upsell_card">
                            <div class="cart_drawer_upsell_copy">
                              <div class="cart_drawer_upsell_label_row">
                                <p class="cart_drawer_upsell_label">{{ settings.cart_upsell_c2_card_title | default: 'Add 1 tag' }}</p>
                                {%- if settings.cart_upsell_c2_card_badge != blank -%}
                                  <span class="cart_drawer_upsell_badge">{{ settings.cart_upsell_c2_card_badge }}</span>
                                {%- endif -%}
                              </div>
                              <p class="cart_drawer_upsell_price">
                                {%- if settings.cart_upsell_c2_card_price != blank -%}
                                  <span class="cart_drawer_upsell_price_sale">{{ settings.cart_upsell_c2_card_price }}</span>
                                {%- endif -%}
                                {%- if settings.cart_upsell_c2_card_compare_price != blank -%}
                                  <s class="cart_drawer_upsell_price_compare">{{ settings.cart_upsell_c2_card_compare_price }}</s>
                                {%- endif -%}
                              </p>
                            </div>
                            {%- if is_qty_pack_setup -%}
                              <cart-pack-upgrade
                                data-key="{{ upsell_item.key }}"
                                data-variant-id="{{ upsell_item.variant_id }}"
                                data-quantity="3"
                                data-same-variant="true"
                                data-product-id="{{ upsell_item.product.id }}">
                                <button type="button" class="cart_drawer_upsell_btn">{{ settings.cart_upsell_c2_card_button | default: 'Upgrade' }}</button>
                              </cart-pack-upgrade>
                            {%- else -%}
                              <cart-pack-upgrade
                                data-key="{{ upsell_item.key }}"
                                data-variant-id="{{ set_of_3_variant.id }}"
                                data-quantity="1"
                                data-product-id="{{ upsell_item.product.id }}">
                                <button type="button" class="cart_drawer_upsell_btn">{{ settings.cart_upsell_c2_card_button | default: 'Upgrade' }}</button>
                              </cart-pack-upgrade>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endif -%}

              {%- if cart.cart_level_discount_applications.size > 0 -%}
                <div class="cdi_cart_level_discount_wrapper" aria-label="{{ 'sections.cart.cart_level_discount_heading' | t }}">
                  {%- for discount in cart.cart_level_discount_applications -%}
                    <div class="cdi_cart_level_discount">
                      {{- 'icon-discount.svg' | inline_asset_content -}}
                      <p>
                        {{ discount.title | escape }}
                        (-{{ discount.total_allocated_amount | money }})
                      </p>
                    </div>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <div class="cdi_subtotals_wrapper">
                <div class="cdi_subtotal_inner">
                  <span class="cdi_subtotal_label">Subtotal</span>
                  <span class="cdi_subtotal_value">{{ cart.total_price | money }}</span>
                </div>
              </div>

              <div class="cdi_action_buttons_wrapper">
                <form action="{{ routes.cart_url }}" method="post">
                  <button class="btn cart_drawer_checkout_btn" type="submit" name="checkout">
                    Checkout
                  </button>
                </form>
              </div>

              <div class="cart_drawer_guarantee">
                <span class="cart_drawer_guarantee_icon" aria-hidden="true">
                  <img
                    src="https://cdn.shopify.com/s/files/1/0598/6471/1277/files/Frame_2106667239.svg?v=1784921058"
                    width="32"
                    height="32"
                    alt=""
                    loading="lazy"
                  >
                </span>
                <span class="cart_drawer_guarantee_text">30-day money-back guarantee</span>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</cart-drawer>
