{{ 'Elza.css' | asset_url | stylesheet_tag }}
{{ 'emergency-contact-popup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'emergency-contact-popup.js' | asset_url }}" defer></script>

<div
  class="em-contact-popup"
  data-em-contact-popup
  role="dialog"
  aria-modal="true"
  aria-labelledby="em-contact-popup-title"
  aria-hidden="true"
  hidden
>
  <div class="em-contact-popup__panel">
    <button type="button" class="em-contact-popup__close" data-em-contact-close>
      <img
        class="em-contact-popup__close-icon"
        src="https://cdn.shopify.com/s/files/1/0598/6471/1277/files/Container.svg?v=1785330254"
        alt=""
        width="24"
        height="24"
      >
      <span>close</span>
    </button>

    <div class="em-contact-popup__title" id="em-contact-popup-title">
      <span class="em-contact-popup__title-fill">get in touch</span>
      <span class="em-contact-popup__title-outline">with us</span>
    </div>

    <div class="em-contact-popup__content">
      {%- form 'contact', id: 'EmergencyContactForm', class: 'em-contact-popup__form' -%}
        <div class="em-contact-popup__fields">
          <div class="em-contact-popup__field">
            <input
              type="text"
              name="contact[name]"
              id="EmergencyContactName"
              placeholder="Name"
              class="em-contact-popup__input"
              required
              autocomplete="name"
            >
          </div>
          <div class="em-contact-popup__field">
            <input
              type="email"
              name="contact[email]"
              id="EmergencyContactEmail"
              placeholder="Email"
              class="em-contact-popup__input"
              required
              autocomplete="email"
            >
          </div>
          <div class="em-contact-popup__field">
            <textarea
              name="contact[body]"
              id="EmergencyContactMessage"
              placeholder="Message"
              class="em-contact-popup__input em-contact-popup__textarea"
              required
            ></textarea>
          </div>
        </div>

        <div class="em-contact-popup__policy">
          <input type="checkbox" name="policy" id="EmergencyContactPolicy" required>
          <label for="EmergencyContactPolicy">
            <span class="em-contact-popup__checkbox" aria-hidden="true"></span>
            <span class="em-contact-popup__policy-text">
              I accept the
              <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a>
              and
              <a href="{{ shop.terms_of_service.url | default: '/policies/terms-of-service' }}">Terms and Conditions.</a>
            </span>
          </label>
        </div>

        <button type="submit" class="em-contact-popup__submit">GET IN TOUCH</button>
      {%- endform -%}
    </div>
  </div>
</div>

<button type="button" class="em-contact-popup__overlay" data-em-contact-close aria-label="Close contact form" tabindex="-1"></button>
