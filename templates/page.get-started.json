    "kopilot_faq_jmWn4N": {
      "type": "kopilot-faq",
      "blocks": {
        "question_nfTmwi": {
          "type": "question",
          "settings": {
            "question": "How do I use KOPILOT.ID in an emergency situation?",
            "answer": "<p>KOPILOT.ID is a smart NFC tag linked to a participant's digital medical ID profile. When someone taps the tag with a smartphone, it instantly opens their profile with critical medical information and emergency contacts. In an emergency, this gives first responders, medics, or bystanders access to the information they need to make faster, more informed decisions when every second counts.</p>"
          }
        },
        "question_HxLLtj": {
          "type": "question",
          "settings": {
            "question": "Does KOPILOT.ID NFC tag require batteries, charging, or a subscription?",
            "answer": "<p>No. KOPILOT.ID NFC tags are completely battery-free and never need charging. There are also no ongoing subscription fees required for participants to use their profile, making it a simple and dependable solution for everyday use.</p>"
          }
        },
        "question_ANcAhf": {
          "type": "question",
          "settings": {
            "question": "Do people need to download an app to scan the tag?",
            "answer": "<p>No app needed. Your profile opens directly in a smartphone browser when someone taps their phone on the NFC tag.</p>"
          }
        },
        "question_8H4i3H": {
          "type": "question",
          "settings": {
            "question": "What gear can I attach the NFC tag to?",
            "answer": "<p>KOPILOT.ID is designed for helmets, goggles, packs, bikes, jackets, zipper pulls, keychains, and other everyday or outdoor gear using the included mounting options.</p>"
          }
        },
        "question_kfjQtP": {
          "type": "question",
          "settings": {
            "question": "Can anyone scan my tag and see my information?",
            "answer": "<p>You control your profile completely. Choose what’s visible, update it anytime, or deactivate your NFC ID tag if needed. If your tag is scanned, you’re notified, and access sessions expire automatically.</p>"
          }
        },
        "question_9C3TAa": {
          "type": "question",
          "settings": {
            "question": "Do NFC tags work without cell service?",
            "answer": "<p>Yes. The NFC tag itself works without cell service or battery. As long as the person scanning has a smartphone, they can access your information even in remote areas.</p>"
          }
        },
        "question_987Hfa": {
          "type": "question",
          "settings": {
            "question": "What if I lose my tag?",
            "answer": "<p>You can deactivate your NFC tag instantly from the app. Your information becomes inaccessible from that tag, and you’ll be notified if someone scans it.</p>"
          }
        },
        "question_EtnDik": {
          "type": "question",
          "settings": {
            "question": "Can I manage multiple tags from one account?",
            "answer": "<p>Yes. You can manage multiple profiles and tags for family members, friends, or your crew directly from the KOPILOT.ID app.</p>"
          }
        }
      },
